#####     ipre post action config     #####
ipre_action_open() {
    cd "$(<"$IPRE_CWD_FILE")" || exit 0
    [[ $# -eq 0 || -z "$1" ]] && exit 0
    [[ $# -eq 1 && -d "$1" ]] && exit 0

    local first_file="$1"
    local ext="${first_file:l:e}"
    case "$ext" in
        png|jpg|jpeg|gif|webp|bmp|tiff) nohup imv "$@" >/dev/null 2>&1 & ;;
        pdf|djvu|epub|mobi) nohup zathura "$@" >/dev/null 2>&1 & ;;
        tar|gz|tgz|xz|txz|bz2|tbz2|zip) ;;
        *) ${EDITOR:-nvim} "$@" </dev/tty>/dev/tty ;;
    esac
}


# =========================================================
# Dynamic Function Dispatch
# =========================================================

if [[ "$ACTION" == ipre_action_* ]] && typeset -f "$ACTION" > /dev/null; then
    "$ACTION" "$@"
else
    print_warn "Invalid or unauthorized action: $ACTION"
    exit 1
fi
