# Smart Diff (Requires exactly 2 files in Selection Buffer)
ipre_action_smart_diff() {
    cd "$(<"$IPRE_CWD_FILE")" || exit 0
    enter_alt_screen
    if [[ ! -s "$IPRE_SELECT_FILE" ]]; then
        print_warn "Selection buffer is empty. Mark 2 files first."
        printf "Press any key to return..."
        read -k 1 -s _ < /dev/tty
        leave_alt_screen
        exit 0
    fi
    local -a sel_lines=("${(@f)$(<"$IPRE_SELECT_FILE")}")
    if [[ ${#sel_lines[@]} -ne 2 ]]; then
        print_warn "Smart Diff requires EXACTLY 2 files. You selected ${#sel_lines[@]}."
        printf "Press any key to return..."
        read -k 1 -s _ < /dev/tty
        leave_alt_screen
        exit 0
    fi
    local file1="${sel_lines[1]}"
    local file2="${sel_lines[2]}"
    if [[ ! -f "$file1" || ! -f "$file2" ]]; then
        print_warn "Both targets must be valid files, not directories."
        printf "Press any key to return..."
        read -k 1 -s _ < /dev/tty
        leave_alt_screen
        exit 0
    fi
    ${EDITOR:-nvim} -d "$file1" "$file2" </dev/tty >/dev/tty
    # Clear the buffer after successful diffing
    printf "" > "$IPRE_SELECT_FILE"
    leave_alt_screen
}

ipre_action_live_grep() {
    cd "$(<"$IPRE_CWD_FILE")" || exit 0
    if ! command -v rg &> /dev/null; then
        enter_alt_screen
        print_warn "Ripgrep is not installed."
        printf "Press any key to return..."
        read -k 1 -s _ < /dev/tty
        leave_alt_screen
        exit 0
    fi

    enter_alt_screen
    local RG_PREFIX="rg --column --line-number --no-heading --color=always --smart-case"
    local selected
    selected=$(
        fzf -m --prompt "Ripgrep > " \
            --ansi --disabled --layout=reverse \
            --bind "start:reload:$RG_PREFIX {q} || true" \
            --bind "change:reload:sleep 0.1; $RG_PREFIX {q} || true" \
            --bind "alt-f:unbind(change)+change-prompt(Fuzzy > )+enable-search+clear-query" \
            --bind "alt-r:rebind(change)+change-prompt(Ripgrep > )+disable-search+clear-query+reload($RG_PREFIX {q} || true)" \
            --bind "alt-a:select-all" \
            --bind "alt-d:deselect-all" \
            --bind "ctrl-f:preview-half-page-down" \
            --bind "ctrl-b:preview-half-page-up" \
            --preview "cd '$(<"$IPRE_CWD_FILE")' && pre {1} {2} 2>/dev/null" \
            --preview-window "right:50%,border-left,+{2}-/2" \
            --delimiter ":" \
            < /dev/tty
    )
    leave_alt_screen

    if [[ -n "$selected" ]]; then
        local -a lines=("${(@f)selected}")
        local -A unique_files
        local first_target=""
        for line in "${lines[@]}"; do
            local filepath="${line%%:*}"
            if [[ -n "$filepath" && -e "$filepath" ]]; then
                filepath="$(realpath -s "$filepath")"
                unique_files[$filepath]=1
                [[ -z "$first_target" ]] && first_target="$filepath"
            fi
        done
        # Inject items into the Selection Buffer (Mark system)
        if [[ ${#unique_files[@]} -gt 0 ]]; then
            local target_dir="${first_target:h}"
            local target_name="${first_target:t}"
            echo "$target_dir" > "$IPRE_CWD_FILE"
            echo 'all' > "$IPRE_STATE_FILE"
            printf "" > "$IPRE_TARGETS_FILE"
            echo "$target_name" > "$IPRE_RAM_FOCUS_FILE"
            if [[ ${#unique_files[@]} -gt 1 ]]; then
                local f
                for f in ${(k)unique_files}; do
                    if ! grep -Fxq "$f" "$IPRE_SELECT_FILE" 2>/dev/null; then
                        echo "$f" >> "$IPRE_SELECT_FILE"
                    fi
                done
            fi
        fi
    fi
}

ipre_action_zoxide() {
