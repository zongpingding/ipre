# Generalized List Jumper (Used by Bookmarks and Selection)
ipre_action_jump_from_list() {
    local list_file="$1"
    local prompt_text="$2"
    local hint_text="$3"

    touch "$list_file"
    local -a items=("${(@f)$(<"$list_file")}")
    local -a valid_items
    local item

    for item in "${items[@]}"; do
        [[ -n "$item" && -e "$item" ]] && valid_items+=("$item")
    done
    printf "%s\n" "${valid_items[@]}" > "$list_file"

    if [[ ${#valid_items[@]} -eq 0 ]]; then
        clear
        print_warn "No valid items found in ${prompt_text}."
        [[ -n "$hint_text" ]] && printf "%s\n\n" "$hint_text"
        printf "Press any key to continue..."
        read -k 1 -s _ < /dev/tty
        return 1
    fi

    local selected="$(fzf --prompt "${prompt_text} > " --reverse < "$list_file")"
    if [[ -n "$selected" ]]; then
        if [[ -d "$selected" ]]; then
            echo "$selected" > "$IPRE_CWD_FILE"
        else
            echo "${selected:h}" > "$IPRE_CWD_FILE"
        fi
        echo 'all' > "$IPRE_STATE_FILE"
        printf "" > "$IPRE_TARGETS_FILE"
        return 0 # Success jump
    fi
    return 1 # Cancelled
}

# inspect selection & clip system(buffer)
ipre_action_show_buffers() {
    # State machine loop for continuous rapid actions
    local choice
    while true; do
        clear
        local clip_cnt=0 sel_cnt=0 op="COPY"
        local -a clip_lines=() sel_lines=() clip_paths=() sel_paths=()

        if [[ -s "$IPRE_CLIP_FILE" ]]; then
            clip_lines=("${(@f)$(<"$IPRE_CLIP_FILE")}")
            clip_cnt=$(( ${#clip_lines[@]} - 1 ))
            op="${clip_lines[1]}"
            clip_paths=("${clip_lines[@]:1}")
        fi
        if [[ -s "$IPRE_SELECT_FILE" ]]; then
            sel_lines=("${(@f)$(<"$IPRE_SELECT_FILE")}")
            sel_cnt=${#sel_lines[@]}
            sel_paths=("${sel_lines[@]}")
        fi

        print_title "Buffer Manager"
        printf "Clipboard : %b%d%b items (Op: %b%s%b)\n" "$C_MAG" "$clip_cnt" "$C_RST" "$C_MAG" "$op" "$C_RST"
        printf "Selection : %b%d%b items\n\n" "$C_YLW" "$sel_cnt" "$C_RST"
        printf "Quick Actions:\n"
        printf "  [%b p %b] Print contents    [%b t %b] Toggle COPY/CUT\n" "$C_GRN" "$C_RST" "$C_MAG" "$C_RST"
        printf "  [%b > %b] Move SEL -> CLIP  [%b < %b] Move CLIP -> SEL\n" "$C_CYN" "$C_RST" "$C_CYN" "$C_RST"
        printf "  [%b , %b] Copy SEL -> CLIP  [%b . %b] Copy CLIP -> SEL\n" "$C_YLW" "$C_RST" "$C_YLW" "$C_RST"
        printf "  [%b 1 %b] Clear Both        [%b 2 %b] Clear Clip   [%b 3 %b] Clear Sel\n" "$C_RED" "$C_RST" "$C_RED" "$C_RST" "$C_RED" "$C_RST"
        printf "  [%b s %b] Jump to SEL dir   [%b v %b] Enter Editor (or type %b:v%b / %b/vim%b)\n" "$C_CYN" "$C_RST" "$C_BLU" "$C_RST" "$C_HL" "$C_RST" "$C_HL" "$C_RST"
        printf "  [%b q %b] Exit Manager\n\n" "$C_RST" "$C_RST"

        # Hybrid key detection for vi-like commands
        read -k 1 -s "choice?Choice: " < /dev/tty
        if [[ "$choice" == ":" || "$choice" == "/" ]]; then
            printf "%s" "$choice"
            local rest
            read -r rest < /dev/tty
            choice="$choice$rest"
        fi
        case "$choice" in
            p|P)
                clear
                print_title "Buffer Contents"
                printf "[CLIPBOARD] - %b%s%b\n" "$C_MAG" "$op" "$C_RST"
                if [[ $clip_cnt -gt 0 ]]; then
                    local filepath
                    for filepath in "${clip_paths[@]}"; do
                        printf "  %b%s%b\n" "$C_YLW" "$filepath" "$C_RST"
                    done
                else
                    printf "  (Empty)\n"
                fi
                echo ""
                printf "[SELECTION]\n"
                if [[ $sel_cnt -gt 0 ]]; then
                    local filepath
                    for filepath in "${sel_paths[@]}"; do
                        printf "  %b%s%b\n" "$C_CYN" "$filepath" "$C_RST"
                    done
                else
                    printf "  (Empty)\n"
                fi
                echo ""
                printf "Press any key to return..."
                read -k 1 -s _ < /dev/tty
                ;;
            \>)
                if [[ $sel_cnt -gt 0 ]]; then
                    # -aU ensures automatic deduplication while retaining order
                    local -aU combined=("${clip_paths[@]}" "${sel_paths[@]}")
                    printf "%s\n" "$op" "${combined[@]}" > "$IPRE_CLIP_FILE"
                    printf "" > "$IPRE_SELECT_FILE"
                fi
                ;;
            \<)
                if [[ $clip_cnt -gt 0 ]]; then
                    local -aU combined=("${sel_paths[@]}" "${clip_paths[@]}")
                    printf "%s\n" "${combined[@]}" > "$IPRE_SELECT_FILE"
                    printf "" > "$IPRE_CLIP_FILE"
                fi
                ;;
            \,)
                if [[ $sel_cnt -gt 0 ]]; then
                    local -aU combined=("${clip_paths[@]}" "${sel_paths[@]}")
                    printf "%s\n" "$op" "${combined[@]}" > "$IPRE_CLIP_FILE"
                fi
                ;;
            \.)
                if [[ $clip_cnt -gt 0 ]]; then
                    local -aU combined=("${sel_paths[@]}" "${clip_paths[@]}")
                    printf "%s\n" "${combined[@]}" > "$IPRE_SELECT_FILE"
                fi
                ;;
            1)
                printf "" > "$IPRE_CLIP_FILE"
                printf "" > "$IPRE_SELECT_FILE"
                ;;
            2)
                printf "" > "$IPRE_CLIP_FILE"
                ;;
            3)
                printf "" > "$IPRE_SELECT_FILE"
                ;;
            t|T)
                if [[ $clip_cnt -gt 0 ]]; then
                    local tmp_clip="$(mktemp)"
                    if [[ "$op" == "COPY" ]]; then
                        echo "CUT" > "$tmp_clip"
                    else
                        echo "COPY" > "$tmp_clip"
                    fi
                    printf "%s\n" "${clip_paths[@]}" >> "$tmp_clip"
                    mv -- "$tmp_clip" "$IPRE_CLIP_FILE"
                fi
                ;;
            v|V|:v|/vim)
                local tmpfile="$(mktemp)"
                local -a c_paths=() s_paths=()
                [[ $clip_cnt -gt 0 ]] && c_paths=("${clip_paths[@]}")
                [[ $sel_cnt -gt 0 ]] && s_paths=("${sel_paths[@]}")

                cat << EOF > "$tmpfile"
# === IPRE BUFFER INSPECTOR ===
# Modify paths directly. Invalid/non-existent paths will be automatically dropped.
# Delete a line to remove it from the buffer.

[OPERATION]
# Valid values: COPY, CUT
$op

[CLIPBOARD]
$(printf "%s\n" "${c_paths[@]}")

[SELECTION]
$(printf "%s\n" "${s_paths[@]}")
EOF

                ${EDITOR:-nvim} "$tmpfile" </dev/tty >/dev/tty

                local -a tmp_lines=("${(@f)$(<"$tmpfile")}")
                local line mode="none"
                local new_op="COPY"
                local -a new_clip=() new_sel=() errors=()

                for line in "${tmp_lines[@]}"; do
                    [[ -z "$line" || "$line" == \#* ]] && continue

                    if [[ "$line" == "[OPERATION]" ]]; then mode="op"; continue; fi
                    if [[ "$line" == "[CLIPBOARD]" ]]; then mode="clip"; continue; fi
                    if [[ "$line" == "[SELECTION]" ]]; then mode="sel"; continue; fi

                    if [[ "$mode" == "op" ]]; then
                        local parsed_op="${line:u}"
                        if [[ "$parsed_op" == "CUT" || "$parsed_op" == "COPY" ]]; then
                            new_op="$parsed_op"
                        else
                            errors+=("Invalid operation '$line'. Defaulted to COPY.")
                        fi
                    elif [[ "$mode" == "clip" || "$mode" == "sel" ]]; then
                        if [[ -e "$line" ]]; then
                            [[ "$mode" == "clip" ]] && new_clip+=("$line")
                            [[ "$mode" == "sel" ]] && new_sel+=("$line")
                        else
                            errors+=("Dropped invalid/missing path: $line")
                        fi
                    fi
                done

                if [[ ${#new_clip[@]} -gt 0 ]]; then
                    printf "%s\n" "$new_op" "${new_clip[@]}" > "$IPRE_CLIP_FILE"
                else
                    printf "" > "$IPRE_CLIP_FILE"
                fi

                if [[ ${#new_sel[@]} -gt 0 ]]; then
                    printf "%s\n" "${new_sel[@]}" > "$IPRE_SELECT_FILE"
                else
                    printf "" > "$IPRE_SELECT_FILE"
                fi

                rm -f -- "$tmpfile"

                if [[ ${#errors[@]} -gt 0 ]]; then
                    {
                        printf "\033[?1049h\033[2J\033[H"
                        print_warn "Inspector Finished with Notices"
                        local err
                        for err in "${errors[@]}"; do
                            printf "  %b- %s%b\n" "$C_YLW" "$err" "$C_RST"
                        done
                        echo ""
                        printf "Press any key to return..."
                    } > /dev/tty
                    read -k 1 -s _ < /dev/tty
                    printf "\033[?1049l" > /dev/tty
                fi

                # Exit loop and return to UI after editor is closed
                break
                ;;
            s|S)
                # NOTE: Call the temporary shared(bookmark) jumper
                #       If it returns 0 (success), break the loop to return to main UI.
                if ipre_action_jump_from_list "$IPRE_SELECT_FILE" "Selection" ""; then
                    break
                fi
                ;;
            q|Q|$'\n'|$'\r')
                break
                ;;
            *)
                # Unmapped key pressed, simply redraw the manager UI
                ;;
        esac
    done
}

#####     yank path     #####
ipre_action_yank_path() {
    cd "$(<"$IPRE_CWD_FILE")" || exit 0
    local item
    local -a paths=()
    for item in "$@"; do
        # Safely strip Nerd Font icon and leading space if icons are enabled
        [[ "$IPRE_ICONS" == "1" ]] && item="${item#* }"
        paths+=("$(realpath -s -- "$item")")
    done
    if [[ ${#paths[@]} -gt 0 ]]; then
        printf "%s\n" "${paths[@]}" | ${CLIPBOARD:-wl-copy}
    fi
}

#####     ipre bookmark     #####
ipre_action_bookmark() {
    cd "$(<"$IPRE_CWD_FILE")" || exit 0
    [[ $# -eq 0 || -z "$1" ]] && exit 0

    touch "$IPRE_BOOKMARKS_FILE"
    local -a bookmarks=("${(@f)$(<"$IPRE_BOOKMARKS_FILE")}")

    local i target
    for i in "$@"; do
        target="$(realpath -s "$i")"
        if [[ -z "${bookmarks[(r)$target]}" ]]; then
            echo "$target" >> "$IPRE_BOOKMARKS_FILE"
            bookmarks+=("$target")
        fi
    done
}

