#!/usr/bin/env zsh

setopt extended_glob

source "${0:A:h}/ipre_paths"
ACTION="$1"
shift
local protocol=raw
if [[ "$1" == --encoded || "$1" == --records ]]; then
    protocol="${1#--}"
    shift
elif [[ "$1" == -- ]]; then
    shift
fi
if [[ "$protocol" != raw ]]; then
    local -a decoded_args=()
    local arg index=0
    for arg in "$@"; do
        (( ++index ))
        if [[ ( "$ACTION" == ipre_action_smart_scroll && $index == 1 ) ||
              ( "$ACTION" == ipre_action_rg_preview && $index == 2 ) ]]; then
            decoded_args+=("$arg")
        elif [[ -z "$arg" ]]; then
            decoded_args+=("")
        else
            if [[ "$protocol" == records ]]; then
                ipre_record_path "$arg"
            else
                ipre_saved_path_decode "$arg"
            fi
            if (( $? != 0 )) || [[ "$REPLY" != /* ]]; then
                printf 'Invalid encoded path\n' >&2
                exit 1
            fi
            decoded_args+=("$REPLY")
        fi
    done
    set -- "${decoded_args[@]}"
fi
ITEM="$1"
if ! ipre_state_read_path "$IPRE_CWD_FILE" || [[ "$REPLY" != /* ]]; then
    printf 'Invalid current directory state\n' >&2
    exit 1
fi
IPRE_CWD="$REPLY"


# =========================================================
# ipre_backend bootstrap
# =========================================================

# Clip & Select Buffer Merge
if [[ "$ACTION" == "ipre_action_command_palette" ]]; then
    if [[ -s "$IPRE_SELECT_FILE" ]]; then
        local -a sel_args=("${(@f)$(<"$IPRE_SELECT_FILE")}")
        local value
        for value in "${sel_args[@]}"; do
            ipre_saved_path_decode "$value" || exit 1
            set -- "$@" "$REPLY"
        done
        local -A seen_args
        local -a final_args=()
        for arg in "$@"; do
            if [[ -z "${seen_args[$arg]}" ]]; then
                final_args+=("$arg")
                seen_args[$arg]=1
            fi
        done
        set -- "${final_args[@]}"
    fi
fi

# Load external modules
source "${0:A:h}/ipre_palette"

# Semantic UI Constants
readonly C_RST='\033[0m'
readonly C_RED='\033[1;31m'
readonly C_GRN='\033[1;32m'
readonly C_YLW='\033[1;33m'
readonly C_CYN='\033[1;36m'
readonly C_MAG='\033[1;35m'

print_title()  { printf "%b=== %s ===%b\n" "$C_CYN" "$1" "$C_RST"; }
print_warn()   { printf "%b=== %s ===%b\n\n" "$C_RED" "$1" "$C_RST"; }
print_label()  { ipre_text_escape "$1"; printf "%b%s%b" "$C_GRN" "$REPLY" "$C_RST"; }
print_hl()     { ipre_text_escape "$1"; printf "%b%s%b" "$C_YLW" "$REPLY" "$C_RST"; }
print_clip()   { printf "[%b%s: %d%b] " "$C_MAG" "$1" "$2" "$C_RST"; }

# alternate screen
enter_alt_screen_init() {
    printf '\033[?1049h' > /dev/tty
}
enter_alt_screen() {
    # enter + clear + cursor(1, 1)
    printf "\033[?1049h\033[2J\033[H" > /dev/tty
}
leave_alt_screen() {
    printf '\033[?1049l' > /dev/tty
}


