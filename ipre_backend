# Core Command Implementations
# =========================================================

#####     status bar & header info     #####
ipre_action_border_status() {
    local targets="$(<"$IPRE_TARGETS_FILE")"
    local cwd clip_str depth depth_str git_str

    # entry mode & cwd
    local state="$(<"$IPRE_STATE_FILE")"
    if [[ -n "$targets" ]]; then
        cwd="[Multiple Directories]"
    else
        cwd="$IPRE_CWD"
        cwd="${cwd/#$HOME/~}"
    fi
    ipre_text_escape "$cwd"; cwd="$REPLY"
    local entry_mode_cwd="$(printf '[%b%s%b:%s]' "$C_CYN" "$state" "$C_RST" "$cwd")"

    # clip|select status
    local border_tag="" clip_cnt=0 sel_cnt=0 op=""
    if [[ -s "$IPRE_CLIP_FILE" ]]; then
        local -a clip_lines=("${(@f)$(<"$IPRE_CLIP_FILE")}")
        clip_cnt=$(( ${#clip_lines[@]} - 1 ))
        op="${clip_lines[1]}"
    fi
    if [[ -s "$IPRE_SELECT_FILE" ]]; then
        local -a sel_lines=("${(@f)$(<"$IPRE_SELECT_FILE")}")
        sel_cnt=${#sel_lines[@]}
    fi
    if [[ $clip_cnt -gt 0 || $sel_cnt -gt 0 ]]; then
        border_tag="["
        [[ $clip_cnt -gt 0 ]] && border_tag+="$(printf '%b%s:%d%b' "$C_MAG" "$op" "$clip_cnt" "$C_RST")"
        [[ $clip_cnt -gt 0 && $sel_cnt -gt 0 ]] && border_tag+="|"
        [[ $sel_cnt -gt 0 ]] && border_tag+="$(printf '%bSEL:%d%b' "$C_YLW" "$sel_cnt" "$C_RST")"
        border_tag+="]"
    fi
    clip_str="$border_tag"

    # max dir depth
    depth="$(<"$IPRE_RAM_DEPTH_FILE" 2>/dev/null)"
    depth_str=""
    if [[ -n "$depth" && "$depth" -gt 0 ]]; then
        depth_str="$(printf '[%bDepth:%s%b]' "$C_YLW" "$depth" "$C_RST")"
    elif [[ "$depth" == "0" ]]; then
        depth_str="$(printf '[%bDepth:oo%b]' "$C_YLW" "$C_RST")"
    fi

    # git status
    git_str=""
    if git -C "$IPRE_CWD" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        local branch="$(git -C "$IPRE_CWD" branch --show-current 2>/dev/null)"
        local changes="$(git -C "$IPRE_CWD" status --porcelain 2>/dev/null | wc -l)"
        if [[ "$changes" -gt 0 ]]; then
            git_str="$(printf '[%bGit:%s *%d%b]' "$C_MAG" "$branch" "$changes" "$C_RST")"
        else
            git_str="$(printf '[%bGit:%s%b]' "$C_GRN" "$branch" "$C_RST")"
        fi
    fi

    # sort mode
    local sort_mode="$(<"$IPRE_SORT_FILE" 2>/dev/null)"
    local sort_str="$(printf '[%bSort:%s%b]' "$C_YLW" "${sort_mode:-name}" "$C_RST")"

    # help info
    local help_info="$(printf '[%b%s%b]' "$C_GRN" "HELP:M+?|ESC:C-g" "$C_RST")"

    printf '%s%s%s%s%s%s' "$help_info" "$git_str" "$sort_str" "$depth_str" "$clip_str" "$entry_mode_cwd"
}

ipre_action_header_info() {
    cd "$IPRE_CWD" || exit 0
    local info description
    if [[ -n "$ITEM" && -f "$ITEM" ]]; then
        local du_out="$(du -sh -- "$ITEM" 2>/dev/null)"
        local size="${du_out%%[[:space:]]*}"
        description="$(file --brief -- "$ITEM" 2>/dev/null)"
        ipre_text_escape "$description"
        info="$(printf '[%b%s%b]: %s' "$C_YLW" "$size" "$C_RST" "$REPLY")"
    elif [[ -n "$ITEM" ]]; then
        info="$(file --brief -- "$ITEM" 2>/dev/null || echo 'No file')"
        ipre_text_escape "$info"; info="$REPLY"
    else
        info="Empty directory / No matches"
    fi
    local notice=""
    [[ -n "$IPRE_NOTICE_FILE" && -s "$IPRE_NOTICE_FILE" ]] && notice="$(<"$IPRE_NOTICE_FILE")"
    if [[ -n "$notice" ]]; then
        printf '%b%s%b | %s\n' "$C_RED" "$notice" "$C_RST" "$info"
    else
        printf '%s\n' "$info"
    fi
}


#####     list entry(kernel)     #####
# fd supplies lossless paths. Presentation is built separately from those paths.
ipre_listing_records() {
    cd -- "$IPRE_CWD" || return 1
    local run_cmd="$IPRE_FD_CMD_STR --print0 --color=never"
    local state="$(<"$IPRE_STATE_FILE")" depth="$(<"$IPRE_RAM_DEPTH_FILE")"
    local sort_mode="$(<"$IPRE_SORT_FILE")" value quoted record label priority key IPRE_INPUT_BUFFER=""
    local -a targets=("${(@f)$(<"$IPRE_TARGETS_FILE")}") sort_args=()
    [[ "$(<"$IPRE_HIDDEN_FILE")" == true ]] && run_cmd+=' --hidden'
    [[ "$depth" == <-> && "$depth" -gt 0 ]] && run_cmd+=" --max-depth $depth"
    case "$state" in
        directory) run_cmd+=' --type d' ;;
        file) run_cmd+=' --type f --type l' ;;
        *) run_cmd+=' --type d --type f --type l' ;;
    esac
    for value in "${targets[@]}"; do
        [[ -z "$value" ]] && continue
        ipre_saved_path_decode "$value" || return 1
        printf -v quoted '%q' "$REPLY"
        run_cmd+=" $quoted"
    done
    if [[ "$depth" == 0 ]]; then
        eval "$run_cmd" 2>/dev/null | while ipre_stream_read $'\0'; do
            value="$REPLY"
            [[ "$state" == file && -d "$value" ]] && continue
            ipre_emit_record "$value"
        done
        return 0
    fi

    zmodload zsh/stat || return 1
    local -A attrs=()
    case "$sort_mode" in
        time|size) sort_args=(-t $'\t' -k1,1n -k2,2nr -k3,3fV) ;;
        *) sort_args=(-t $'\t' -k1,1n -k2,2fV -k3,3fV) ;;
    esac
    eval "$run_cmd" 2>/dev/null | {
        while ipre_stream_read $'\0'; do
            value="$REPLY"
            value="${value:a}"
            [[ "$state" == file && -d "$value" ]] && continue
            [[ -d "$value" ]] && priority=0 || priority=1
            ipre_display_path "$value"
            label="$REPLY"
            case "$sort_mode" in
                time|size)
                    attrs=()
                    zstat -H attrs -- "$value" 2>/dev/null
                    [[ "$sort_mode" == time ]] && key="${attrs[mtime]:-0}" || key="${attrs[size]:-0}"
                    ;;
                ext) ipre_text_escape "${value:l:e}"; key="$REPLY" ;;
                *) key="$label" ;;
            esac
            printf '%s\t%s\t%s\t' "$priority" "$key" "$label"
            ipre_emit_record "$value"
        done
    } | LC_ALL=C sort "${sort_args[@]}" | cut -f4-
}

ipre_action_run() {
    # Keep the exact records for focus lookup, including during streaming reloads.
    ipre_listing_records | tee "$IPRE_RAM_LIST_FILE"
}


#####  Page-Flipping Preview Engine   #####
ipre_action_change_page() {
    local opt="$1"
    local current=1
    [[ -f "$IPRE_PAGE_FILE" ]] && current=$(<"$IPRE_PAGE_FILE")
    if [[ "$opt" == "next" ]]; then
        ((current++))
    elif [[ "$opt" == "prev" ]]; then
        ((current--))
    fi
    if (( current < 1 )); then
        echo 1 > "$IPRE_PAGE_FILE"
        return 0
    fi

    # Cache page_max
    local page_max=""
    cd "$IPRE_CWD" || exit 0
    if [[ -s "$IPRE_PAGE_MAX_FILE" ]]; then
        page_max=$(<"$IPRE_PAGE_MAX_FILE")
    else
        local file=""
        ipre_state_read_path "$IPRE_LAST_FILE" && file="$REPLY"
        if [[ -n "$file" && -f "$file" ]]; then
            local ext="${file:l:e}"
            local file_type
            file_type=$(pre get_file_type "$file" "$ext" 2>/dev/null)
            case "$file_type" in
                pdf)  page_max=$(pdfinfo "$file" 2>/dev/null | awk '/^Pages:/ {print $2}') ;;
                djvu) page_max=$(djvused -e 'n' "$file" 2>/dev/null) ;;
            esac
        fi
        # Fallback: empty, non-numeric
        [[ -z "$page_max" || ! "$page_max" =~ ^[0-9]+$ ]] && page_max=999999
        echo "$page_max" > "$IPRE_PAGE_MAX_FILE"
    fi
    if (( current > page_max )); then 
        echo "$page_max" > "$IPRE_PAGE_FILE"
    else
        echo "$current" > "$IPRE_PAGE_FILE"
    fi
}

ipre_action_preview_with_page() {
    printf '\033[2J\033[H'
    local target="$1"
    cd "$IPRE_CWD" || exit 0
    local file="${target:a}"
    local page=1
    local last_file_name=""
    ipre_state_read_path "$IPRE_LAST_FILE" && last_file_name="$REPLY"

    if [[ "$file" != "$last_file_name" ]]; then
        echo 1 > "$IPRE_PAGE_FILE"
        printf "" > "$IPRE_PAGE_MAX_FILE"
        ipre_state_write_path "$IPRE_LAST_FILE" "$file"
        page=1
    else
        [[ -f "$IPRE_PAGE_FILE" ]] && page=$(<"$IPRE_PAGE_FILE")
    fi
    cd "$IPRE_CWD" || exit 0
    pre "$file" "PAGE:$page" 2>/dev/null
}

# Smart Scroll Dispatcher (FZF Transform Protocol)
ipre_action_smart_scroll() {
    local dir="$1"
    local target="$2"
    local file="${target:a}"
    local ext="${file:l:e}"
    local file_type
    file_type=$(pre get_file_type "$file" "$ext" 2>/dev/null)
    if [[ "$file_type" == "pdf" || "$file_type" == "djvu" ]]; then
        if [[ "$dir" == "down" ]]; then
            ipre_action_change_page next
        else
            ipre_action_change_page prev
        fi
        echo "refresh-preview"
    else
        if [[ "$dir" == "down" ]]; then
            echo "preview-half-page-down"
        else
            echo "preview-half-page-up"
        fi
    fi
}


#####     simple entry operation     #####
ipre_action_sort_cycle() {
    local cur="$(<"$IPRE_SORT_FILE")"
    case "$cur" in
        name) echo "time" > "$IPRE_SORT_FILE" ;;
        time) echo "size" > "$IPRE_SORT_FILE" ;;
        size) echo "ext"  > "$IPRE_SORT_FILE" ;;
        ext)  echo "name" > "$IPRE_SORT_FILE" ;;
        *)    echo "name" > "$IPRE_SORT_FILE" ;;
    esac
}

ipre_action_set_depth() {
    local new_val="$ITEM"
    local cur="$(<"$IPRE_RAM_DEPTH_FILE" 2>/dev/null)"
    [[ -z "$cur" ]] && cur=0

    if [[ "$new_val" == "+" ]]; then
        echo $((cur + 1)) > "$IPRE_RAM_DEPTH_FILE"
    elif [[ "$new_val" == "-" ]]; then
        if [[ "$cur" -gt 0 ]]; then
            echo $((cur - 1)) > "$IPRE_RAM_DEPTH_FILE"
        fi
    else
        echo "$new_val" > "$IPRE_RAM_DEPTH_FILE"
    fi
}

ipre_action_switch() {
    local state="$(<"$IPRE_STATE_FILE")"
    if [[ "$state" == "file" ]]; then
        echo 'directory' > "$IPRE_STATE_FILE"
    elif [[ "$state" == "directory" ]]; then
        echo 'all' > "$IPRE_STATE_FILE"
    else
        echo 'file' > "$IPRE_STATE_FILE"
    fi
    ipre_action_run
}

ipre_action_hidden() {
    if [[ "$(<"$IPRE_HIDDEN_FILE")" == "true" ]]; then
        echo 'false' > "$IPRE_HIDDEN_FILE"
    else
        echo 'true' > "$IPRE_HIDDEN_FILE"
    fi
}


#####     Entry list navigation     #####
ipre_focus_line() {
    local target="$(<"$IPRE_RAM_FOCUS_FILE")" line key number=0
    REPLY=""
    while IFS= read -r line; do
        (( ++number ))
        key="${line%%$'\t'*}"
        if [[ "$key" == "$target" ]]; then
            REPLY="$number"
            return 0
        fi
    done < "$IPRE_RAM_LIST_FILE"
    return 1
}

ipre_action_focus_position() {
    if [[ -s "$IPRE_RAM_POS_FILE" ]]; then
        printf 'pos(%s)\n' "$(<"$IPRE_RAM_POS_FILE")"
        : > "$IPRE_RAM_POS_FILE"
    elif [[ -s "$IPRE_RAM_FOCUS_FILE" ]] && ipre_focus_line; then
        printf 'pos(%s)\n' "$REPLY"
        rm -f -- "$IPRE_RAM_FOCUS_FILE"
    fi
    return 0
}

ipre_action_refresh_and_focus() {
    if [[ ! -s "$IPRE_RAM_FOCUS_FILE" ]]; then
        printf 'reload(%q ipre_action_run)\n' "$IPRE_BACKEND_CMD"
        return 0
    elif [[ "$(<"$IPRE_RAM_DEPTH_FILE")" == 0 ]]; then
        printf 'reload(%q ipre_action_run)+clear-query\n' "$IPRE_BACKEND_CMD"
        return 0
    fi
    ipre_action_run >/dev/null
    if ipre_focus_line; then
        printf '%s\n' "$REPLY" > "$IPRE_RAM_POS_FILE"
        rm -f -- "$IPRE_RAM_FOCUS_FILE"
    fi
    printf 'reload-sync(cat %q)+clear-query\n' "$IPRE_RAM_LIST_FILE"
}

ipre_action_left() {
    local cur="$IPRE_CWD" parent="${IPRE_CWD:h}"
    [[ -z "$parent" ]] && parent=/
    if [[ "$cur" != "$parent" ]]; then
        ipre_set_cwd "$parent"
        ipre_set_focus "$cur"
    fi
    printf 'all\n' > "$IPRE_STATE_FILE"
    : > "$IPRE_TARGETS_FILE"
    ipre_action_refresh_and_focus
}

ipre_action_right() {
    cd -- "$IPRE_CWD" || return 1
    if [[ -n "$ITEM" ]]; then
        local target="${ITEM:a}"
        [[ -d "$target" ]] && ipre_set_cwd "$target" || ipre_set_cwd "${target:h}"
    fi
    printf 'all\n' > "$IPRE_STATE_FILE"
    : > "$IPRE_TARGETS_FILE"
    rm -f -- "$IPRE_RAM_FOCUS_FILE"
    : > "$IPRE_RAM_POS_FILE"
    ipre_action_run
}


#####     Modify entry: select|create|copy|cut|delete|rename etc     #####
ipre_action_mark() {
    cd "$IPRE_CWD" || exit 0
    [[ $# -eq 0 || -z "$1" ]] && exit 0

    touch "$IPRE_SELECT_FILE"
    ipre_path_lines "$@" >> "$IPRE_SELECT_FILE"
    local -a dedup=("${(@f)$(awk '!seen[$0]++' "$IPRE_SELECT_FILE")}")
    printf '%s\n' "${dedup[@]}" > "$IPRE_SELECT_FILE"
}

ipre_action_new() {
    cd "$IPRE_CWD" || exit 0
    clear
    print_title "Create New"
    printf 'Current Dir : %s\n' "$(print_label "$PWD")"
    printf 'Syntax Hint : End with %s to create a directory.\n' "$(print_hl "/")"
    printf 'Tokenize    : No need to quote spaces; single quotes are literal and not stripped\n'
    printf '%s\n' 'Name escapes: \n for newline, \t for TAB, \\ for backslash.'
    printf 'Multiple    : Separate with commas (e.g., file1, dir2/, dir3/file3)\n'
    printf 'Cancel      : Clear input (%s) and press %s (or type %s)\n' "$(print_hl "Ctrl+U")" "$(print_hl "Enter")" "$(print_hl ":q")"
    printf 'Batch Mode  : Type %s or %s and press Enter to open Vim\n\n' "$(print_hl ":v")" "$(print_hl "/vim")"

    local names="" tmpfile tmp_lines name_array name
    if ! vared -p "Enter name(s): " names </dev/tty; then
        echo ""
        return 0
    fi
    if [[ -z "$names" || "$names" == ":q" || "$names" == "/q" ]]; then
        exit 0
    elif [[ "$names" == ":v" || "$names" == "/vim" ]]; then
        tmpfile="$(mktemp)"
        cat << 'EOF2' > "$tmpfile"
# === Batch Create Files & Directories ===
# 1. Write one item per line.
# 2. End with '/' to create a directory (e.g., src/components/ )
# 3. Lines starting with '#' or empty lines will be ignored.
# 4. Spaces and quotes are literal. Escapes: \\ = backslash, \n = newline, \t = tab.
# 5. Save and exit (:wq) to apply. Delete all lines or exit without saving (:q!) to cancel.

EOF2
        ${EDITOR:-nvim} "$tmpfile" </dev/tty >/dev/tty
        tmp_lines=("${(@f)$(<"$tmpfile")}")
        for name in "${tmp_lines[@]}"; do
            name="${name## #}"
            name="${name%% #}"
            [[ -z "$name" || "$name" == \#* ]] && continue
            ipre_text_unescape "$name" || { printf 'Invalid name escape\n' >&2; continue; }
            name="$REPLY"
            [[ ! -f "$IPRE_RAM_FOCUS_FILE" ]] && ipre_set_focus "$name"
            case "$name" in
                */) mkdir -p -- "$name" ;;
                *)  mkdir -p -- "${name:h}"; touch -- "$name" ;;
            esac
        done
        rm -f -- "$tmpfile"
    else
        name_array=("${(@s/,/)names}")
        for name in "${name_array[@]}"; do
            name="${name## #}"
            name="${name%% #}"
            [[ -z "$name" ]] && continue
            ipre_text_unescape "$name" || { printf 'Invalid name escape\n' >&2; continue; }
            name="$REPLY"
            [[ ! -f "$IPRE_RAM_FOCUS_FILE" ]] && ipre_set_focus "$name"
            case "$name" in
                */) mkdir -p -- "$name" ;;
                *)  mkdir -p -- "${name:h}"; touch -- "$name" ;;
            esac
        done
    fi
}

ipre_action_copy() {
    cd "$IPRE_CWD" || exit 0
    [[ $# -eq 0 || -z "$1" ]] && exit 0
    [[ -n "$IPRE_NOTICE_FILE" ]] && : > "$IPRE_NOTICE_FILE"
    echo "COPY" > "$IPRE_CLIP_FILE"
    ipre_path_lines "$@" >> "$IPRE_CLIP_FILE"
}

ipre_action_cut() {
    cd "$IPRE_CWD" || exit 0
    [[ $# -eq 0 || -z "$1" ]] && exit 0
    [[ -n "$IPRE_NOTICE_FILE" ]] && : > "$IPRE_NOTICE_FILE"
    echo "CUT" > "$IPRE_CLIP_FILE"
    ipre_path_lines "$@" >> "$IPRE_CLIP_FILE"
}

ipre_action_paste() {
    [[ -n "$IPRE_NOTICE_FILE" ]] && : > "$IPRE_NOTICE_FILE"
    [[ ! -s "$IPRE_CLIP_FILE" ]] && exit 0
    local dest="$IPRE_CWD"
    local -a clip_lines=("${(@f)$(<"$IPRE_CLIP_FILE")}")
    local op="${clip_lines[1]}"
    if [[ "$op" != COPY && "$op" != CUT ]]; then
        printf 'Paste: invalid clipboard operation\n' >&2
        [[ -n "$IPRE_NOTICE_FILE" ]] && printf 'Paste: invalid clipboard operation\n' > "$IPRE_NOTICE_FILE"
        return 1
    fi

    local src encoded base target name ext counter source_dir physical_dest focus_target="" clip_tmp
    local failed=0 cut_completed=0 succeeded
    local -a remaining=()
    physical_dest="${dest:A}"
    for encoded in "${clip_lines[@]:1}"; do
        [[ -z "$encoded" ]] && continue
        if ! ipre_saved_path_decode "$encoded"; then
            remaining+=("$encoded")
            (( ++failed ))
            continue
        fi
        src="$REPLY"
        if [[ ! -d "$dest" || ( ! -e "$src" && ! -L "$src" ) ]]; then
            printf 'Paste: source or destination is unavailable: %s -> %s\n' "$src" "$dest" >&2
            remaining+=("$encoded")
            (( ++failed ))
            continue
        fi

        # Cutting into the same parent is already complete, including path aliases.
        if [[ "$op" == CUT && "${src:h:A}" == "$physical_dest" ]]; then
            (( ++cut_completed ))
            continue
        fi
        if [[ -d "$src" && ! -L "$src" ]]; then
            source_dir="${src:A}"
            if [[ "$physical_dest" == "$source_dir" || "$physical_dest" == "${source_dir%/}/"* ]]; then
                printf 'Paste: cannot place a directory inside itself: %s -> %s\n' "$src" "$dest" >&2
                remaining+=("$encoded")
                (( ++failed ))
                continue
            fi
        fi

        base="${src:t}"
        target="$dest/$base"
        if [[ -e "$target" || -L "$target" ]]; then
            name="${base:r}"
            ext="${base:e}"
            if [[ -z "$name" ]]; then
                name="$base"
                ext=""
            else
                [[ -n "$ext" ]] && ext=".$ext"
            fi

            counter=1
            while [[ -e "$dest/${name}_copy${counter}${ext}" || -L "$dest/${name}_copy${counter}${ext}" ]]; do
                ((counter++))
            done
            target="$dest/${name}_copy${counter}${ext}"
        fi

        succeeded=0
        if [[ "$op" == COPY ]]; then
            cp -r -- "$src" "$target" && succeeded=1
        else
            # A destination appearing after validation must not swallow the source.
            mv -nT -- "$src" "$target" && [[ ! -e "$src" && ! -L "$src" ]] && succeeded=1
        fi
        if (( succeeded )); then
            [[ -z "$focus_target" ]] && focus_target="$target"
            [[ "$op" == CUT ]] && (( ++cut_completed ))
        else
            remaining+=("$encoded")
            (( ++failed ))
        fi
    done

    if [[ "$op" == CUT ]] && (( cut_completed )); then
        # Preserve the previous buffer if writing the replacement fails.
        if clip_tmp=$(mktemp -- "${IPRE_CLIP_FILE:h}/.ipre-clip.XXXXXX"); then
            if (( ${#remaining[@]} )); then
                printf '%s\n' CUT "${remaining[@]}" > "$clip_tmp"
            else
                : > "$clip_tmp"
            fi
            if (( $? != 0 )) || ! mv -f -- "$clip_tmp" "$IPRE_CLIP_FILE"; then
                printf 'Paste: failed to update the cut buffer\n' >&2
                rm -f -- "$clip_tmp"
                (( ++failed ))
            fi
        else
            printf 'Paste: failed to update the cut buffer\n' >&2
            (( ++failed ))
        fi
    fi
    if [[ -n "$focus_target" ]]; then
        ipre_set_focus "$focus_target"
    fi
    if (( failed )); then
        [[ -n "$IPRE_NOTICE_FILE" ]] && printf 'Paste: %d failed\n' "$failed" > "$IPRE_NOTICE_FILE"
        return 1
    fi
    return 0
}

ipre_action_delete() {
    cd "$IPRE_CWD" || exit 0
    [[ $# -eq 0 || -z "$1" ]] && exit 0
    enter_alt_screen
    {
        print_warn "WARNING: SAFE TRASH CONFIRMATION"
        printf "Current Dir : %s\n" "$(print_label "$PWD")"
        printf "Are you sure you want to move the following %d item(s) to the hidden trash bin?\n" "$#"

        local i base ts entry original ans
        local moved=0 failed=0
        for i in "$@"; do
            printf "  %s\n" "$(print_hl "$i")"
        done
        printf "\nType \"y\" to confirm [y/N]: "
        read -r ans </dev/tty || return 1
        [[ "$ans" == "y" || "$ans" == "Y" ]] || return 0

        ts=$(date +%s) || return 1
        for i in "$@"; do
            # Make the path absolute without resolving a symlink's target.
            original="${i:a}"
            base="${original:t}"
            # Reserve a separate entry atomically, including across ipre sessions.
            if [[ -z "$IPRE_TRASH_DIR" || ! -d "$IPRE_TRASH_DIR" ]] ||
               ! entry=$(mktemp -d -- "$IPRE_TRASH_DIR/entry-${ts}.XXXXXX"); then
                printf '%b[Error] Cannot create a trash entry for "%s".%b\n' "$C_RED" "$i" "$C_RST" >&2
                (( ++failed ))
                continue
            fi
            # Store the origin before moving data; NUL preserves any filename.
            if ! mkdir -- "$entry/payload" ||
               ! printf '%s\0' "$original" > "$entry/origin"; then
                printf '%b[Error] Cannot save the original path for "%s".%b\n' "$C_RED" "$i" "$C_RST" >&2
                ipre_trash_remove_empty_entry "$entry" 2>/dev/null
                (( ++failed ))
                continue
            fi
            if mv -- "$i" "$entry/payload/$base"; then
                (( ++moved ))
            else
                printf '%b[Error] Failed to move "%s" to trash.%b\n' "$C_RED" "$i" "$C_RST" >&2
                ipre_trash_remove_empty_entry "$entry" 2>/dev/null
                (( ++failed ))
            fi
        done
        if (( failed == 0 )); then
            printf "%bMoved to trash: %d item(s).%b\n" "$C_GRN" "$moved" "$C_RST"
        else
            printf "%bMoved to trash: %d item(s); failed: %d.%b\n" "$C_YLW" "$moved" "$failed" "$C_RST"
        fi
        sleep 0.5
        (( failed == 0 ))
    } always {
        leave_alt_screen
    }
}

ipre_rename_target_path() {
    local source_path="$1" new_name="$2"
    if [[ "$new_name" == /* ]]; then
        REPLY="${new_name:a}"
    else
        REPLY="${source_path:h}/$new_name"
        REPLY="${REPLY:a}"
    fi
}

ipre_rename_move() {
    # Do not overwrite or move inside a destination that appears after validation.
    mv -nT -- "$1" "$2" && [[ ! -e "$1" && ! -L "$1" ]]
}

ipre_rename_set_focus() {
    [[ -f "$IPRE_RAM_FOCUS_FILE" ]] || ipre_set_focus "$1"
}

ipre_action_rename() {
    cd "$IPRE_CWD" || exit 0
    [[ $# -eq 0 || -z "$1" ]] && exit 0
    clear
    print_title "Rename"
    printf 'Current Dir : %s\n' "$(print_label "$PWD")"
    printf 'Cancel/Skip : Clear input (%s) and press %s\n' "$(print_hl "Ctrl+U")" "$(print_hl "Enter")"
    printf 'Abort Batch : Type %s or %s and press Enter\n\n' "$(print_hl ":q")" "$(print_hl "/q")"
    printf '%s\n' 'Name escapes: \n for newline, \t for TAB, \\ for backslash.'

    local item old_path old_name new_name clean_new target_dir val REPLY
    local failed=0
    for item in "$@"; do
        old_path="${item:a}"
        [[ -e "$old_path" || -L "$old_path" ]] || continue
        ipre_text_escape "${old_path:t}"
        old_name="$REPLY"
        printf 'Source Dir : %s\n' "$(print_label "${old_path:h}")"

        # Keep the basename prefilled while the source path stays separate.
        val=$(bash -c 'read -e -i "$1" -p "Rename '\''$1'\'' to: " ans </dev/tty && printf "%s\n" "$ans"' _ "$old_name")
        if ! ipre_text_unescape "$val"; then
            printf 'Invalid name escape; use \\ for a literal backslash\n' >&2
            failed=1
            continue
        fi
        new_name="$REPLY"

        # Explicitly abort the entire batch process
        [[ "$new_name" == ":q" || "$new_name" == "/q" ]] && break
        # Skip empty inputs
        [[ -z "$new_name" ]] && continue

        if [[ ! -d "$old_path" || -L "$old_path" ]]; then
            case "$new_name" in
                */)
                    printf "%b[Error] Cannot rename a file to a path ending with '/'.%b\n" "$C_RED" "$C_RST"
                    failed=1
                    sleep 1.5
                    continue
                    ;;
            esac
        fi

        ipre_rename_target_path "$old_path" "$new_name"
        clean_new="$REPLY"
        [[ "$clean_new" == "$old_path" ]] && continue
        if [[ -e "$clean_new" || -L "$clean_new" ]]; then
            printf "%b[Error] '%s' already exists. Skipping.%b\n" "$C_RED" "$clean_new" "$C_RST"
            failed=1
            sleep 1.5
            continue
        fi

        target_dir="${clean_new:h}"
        if ! mkdir -p -- "$target_dir" || ! ipre_rename_move "$old_path" "$clean_new"; then
            printf '%b[Error] Failed to rename "%s" to "%s".%b\n' "$C_RED" "$old_path" "$clean_new" "$C_RST" >&2
            failed=1
            continue
        fi
        ipre_rename_set_focus "$clean_new"
    done
    (( failed == 0 ))
}

ipre_wdired_show_errors() {
    enter_alt_screen
    {
        print_warn "Wdired Completed with Errors"
        local err
        for err in "$@"; do
            ipre_text_escape "$err"
            printf "  %b- %s%b\n" "$C_YLW" "$REPLY" "$C_RST"
        done
        printf "\nPress any key to return..."
        read -k 1 -s _ < /dev/tty
    } always {
        leave_alt_screen
    }
}

# FIXME: This function is potentially unsafe; there may be edge cases I haven't accounted for.
ipre_action_wdired() {
    cd "$IPRE_CWD" || exit 0
    [[ $# -eq 0 || -z "$1" ]] && exit 0
    local tmpfile
    tmpfile=$(mktemp) || return 1
    {
        cat << 'EOF' > "$tmpfile"
# === Wdired Batch Rename ===
# Edit the name after the TAB on each [id] row. Keep the identifiers.
# Source paths are comments; the actual source is fixed by its identifier.
# Escapes: \\ for backslash, \n for newline, \t for tab, \xHH for a byte.
# New names are relative to each selected item's parent directory.
# Save and exit to apply. Delete all text to abort.
# WARN: This function is potentially unsafe; there may be edge cases I haven't accounted for.

EOF

        local item source_path prefix line id new_name clean_new target_dir REPLY
        local -a sources=() prefixes=() errors=() valid_olds=() valid_news=()
        local -A seen_sources=() seen_rows=() old_set=() new_set=()
        for item in "$@"; do
            source_path="${item:a}"
            [[ -e "$source_path" || -L "$source_path" ]] || continue
            [[ -n "${seen_sources[$source_path]}" ]] && continue
            seen_sources[$source_path]=1
            sources+=("$source_path")
            prefix="[${#sources[@]}]"$'\t'
            prefixes+=("$prefix")
            ipre_text_escape "$item"
            printf '# [%d] Source: %s\n' "${#sources[@]}" "$REPLY" >> "$tmpfile"
            ipre_text_escape "${source_path:t}"
            printf '%s%s\n' "$prefix" "$REPLY" >> "$tmpfile"
        done
        if (( ${#errors[@]} )); then
            ipre_wdired_show_errors "${errors[@]}"
            return 1
        fi
        (( ${#sources[@]} )) || return 0
        ${EDITOR:-nvim} "$tmpfile" </dev/tty >/dev/tty || return 1
        local -a tmp_lines=("${(@f)$(<"$tmpfile")}")

        # The editable text can never supply a new source path.
        for line in "${tmp_lines[@]}"; do
            [[ -z "$line" || "$line" == \#* ]] && continue
            if [[ "$line" != \[<->\]$'\t'* ]]; then
                errors+=("Invalid batch rename row: $line")
                continue
            fi
            id="${${line#\[}%%\]*}"
            if (( id < 1 || id > ${#sources[@]} )) || [[ -n "${seen_rows[$id]}" ]]; then
                errors+=("Invalid or repeated batch rename identifier: $id")
                continue
            fi
            seen_rows[$id]=1
            prefix="${prefixes[$id]}"
            if [[ "$line" != "$prefix"* ]]; then
                errors+=("The identifier or TAB on row $id was changed")
                continue
            fi
            source_path="${sources[$id]}"
            if ! ipre_text_unescape "${line#"$prefix"}"; then
                errors+=("Invalid name escape on row $id")
                continue
            fi
            new_name="$REPLY"
            [[ -z "$new_name" ]] && continue
            if [[ ! -d "$source_path" || -L "$source_path" ]]; then
                if [[ "$new_name" == */ ]]; then
                    errors+=("Cannot rename '$source_path' to a path ending with '/'")
                    continue
                fi
            fi
            ipre_rename_target_path "$source_path" "$new_name"
            clean_new="$REPLY"
            [[ "$clean_new" == "$source_path" ]] && continue
            if [[ -n "${new_set[$clean_new]}" ]]; then
                errors+=("Multiple files target '$clean_new'")
                continue
            fi
            valid_olds+=("$source_path")
            valid_news+=("$clean_new")
            old_set[$source_path]=1
            new_set[$clean_new]=1
        done
        # A blank edit aborts; a partially damaged edit must not move any files.
        if (( ${#seen_rows[@]} == 0 && ${#errors[@]} == 0 )); then
            return 0
        fi
        local i o n
        for (( i=1; i<=${#sources[@]}; i++ )); do
            [[ -n "${seen_rows[$i]}" ]] || errors+=("Batch rename row $i is missing")
        done
        if (( ${#errors[@]} )); then
            ipre_wdired_show_errors "${errors[@]}"
            return 1
        fi

        # Prevent staging a parent directory from invalidating another row's paths.
        for o in "${valid_olds[@]}" "${valid_news[@]}"; do
            for n in "${valid_olds[@]}" "${valid_news[@]}"; do
                if [[ "$n" == "$o/"* ]]; then
                    errors+=("Rename a directory and its children in separate batches: '$o', '$n'")
                    break 2
                fi
            done
        done
        if (( ${#errors[@]} )); then
            ipre_wdired_show_errors "${errors[@]}"
            return 1
        fi

        # Remove blocked rows repeatedly so swaps and dependency chains stay safe.
        local changed=1
        local -a next_olds=() next_news=()
        while (( changed )); do
            changed=0
            next_olds=() next_news=()
            for (( i=1; i<=${#valid_olds[@]}; i++ )); do
                o="${valid_olds[$i]}"
                n="${valid_news[$i]}"
                if [[ ( -e "$n" || -L "$n" ) && -z "${old_set[$n]}" ]]; then
                    errors+=("'$n' blocks the rename of '$o'")
                    unset "old_set[$o]"
                    changed=1
                else
                    next_olds+=("$o")
                    next_news+=("$n")
                fi
            done
            valid_olds=("${next_olds[@]}")
            valid_news=("${next_news[@]}")
        done

        # Reserve temporary directories beside each source before moving anything.
        local stage_dir failed=0 staged=0 committed=0
        local -a stage_dirs=() stage_paths=()
        for o in "${valid_olds[@]}"; do
            if ! stage_dir=$(mktemp -d -- "${o:h}/.ipre-rename.XXXXXX"); then
                errors+=("Cannot reserve a temporary path for '$o'")
                failed=1
                break
            fi
            stage_dirs+=("$stage_dir")
            stage_paths+=("$stage_dir/${o:t}")
        done
        if (( ! failed )); then
            for (( i=1; i<=${#valid_olds[@]}; i++ )); do
                if ! ipre_rename_move "${valid_olds[$i]}" "${stage_paths[$i]}"; then
                    errors+=("Failed to stage '${valid_olds[$i]}'")
                    failed=1
                    break
                fi
                (( ++staged ))
            done
        fi
        if (( ! failed )); then
            for (( i=1; i<=${#valid_news[@]}; i++ )); do
                target_dir="${valid_news[$i]:h}"
                if ! mkdir -p -- "$target_dir" ||
                   ! ipre_rename_move "${stage_paths[$i]}" "${valid_news[$i]}"; then
                    errors+=("Failed to rename '${valid_olds[$i]}' to '${valid_news[$i]}'")
                    failed=1
                    break
                fi
                (( ++committed ))
            done
        fi
        if (( failed )); then
            # Move committed rows back to staging first, then restore original paths.
            for (( i=committed; i>=1; i-- )); do
                ipre_rename_move "${valid_news[$i]}" "${stage_paths[$i]}" ||
                    errors+=("Rollback failed; data remains at '${valid_news[$i]}'")
            done
            for (( i=staged; i>=1; i-- )); do
                if [[ -e "${stage_paths[$i]}" || -L "${stage_paths[$i]}" ]]; then
                    ipre_rename_move "${stage_paths[$i]}" "${valid_olds[$i]}" ||
                        errors+=("Rollback failed; data remains at '${stage_paths[$i]}'")
                fi
            done
        elif (( ${#valid_news[@]} )); then
            ipre_rename_set_focus "${valid_news[1]}"
        fi
        for stage_dir in "${stage_dirs[@]}"; do
            rmdir -- "$stage_dir" 2>/dev/null
        done
        if (( ${#errors[@]} )); then
            ipre_wdired_show_errors "${errors[@]}"
            return 1
        fi
        return 0
    } always {
        rm -f -- "$tmpfile"
    }
}


#####     selection & clip system management     #####
# Generalized List Jumper (Used by Bookmarks and Selection)
ipre_action_jump_from_list() {
    local list_file="$1" prompt_text="$2" hint_text="$3"
    touch "$list_file"
    local -a items=("${(@f)$(<"$list_file")}") valid_items=() records=()
    local item value
    for item in "${items[@]}"; do
        ipre_saved_path_decode "$item" || continue
        value="$REPLY"
        [[ -e "$value" || -L "$value" ]] || continue
        valid_items+=("$item")
        ipre_text_escape "$value"
        records+=("$item"$'\t'"$REPLY")
    done
    : > "$list_file"
    (( ${#valid_items[@]} )) && printf '%s\n' "${valid_items[@]}" > "$list_file"
    if (( ! ${#valid_items[@]} )); then
        clear
        print_warn "No valid items found in ${prompt_text}."
        [[ -n "$hint_text" ]] && printf '%s\n\n' "$hint_text"
        printf 'Press any key to continue...'
        read -k 1 -s _ < /dev/tty
        return 1
    fi
    local selected
    selected=$(printf '%s\n' "${records[@]}" | fzf --prompt "${prompt_text} > " --reverse --delimiter=$'\t' --with-nth=2)
    [[ -n "$selected" ]] || return 1
    ipre_record_path "$selected" || return 1
    value="$REPLY"
    [[ -d "$value" ]] && ipre_set_cwd "$value" || ipre_set_cwd "${value:h}"
    [[ ! -d "$value" ]] && ipre_set_focus "$value"
    printf 'all\n' > "$IPRE_STATE_FILE"
    : > "$IPRE_TARGETS_FILE"
    return 0
}

# inspect selection & clip system(buffer)
ipre_action_show_buffers() {
    # State machine loop for continuous rapid actions
    local choice
    while true; do
        clear
        local clip_cnt=0 sel_cnt=0 op="COPY"
        local -a clip_lines=() sel_lines=() clip_paths=() sel_paths=()

        if [[ -s "$IPRE_CLIP_FILE" ]]; then
            clip_lines=("${(@f)$(<"$IPRE_CLIP_FILE")}")
            clip_cnt=$(( ${#clip_lines[@]} - 1 ))
            op="${clip_lines[1]}"
            clip_paths=("${clip_lines[@]:1}")
        fi
        if [[ -s "$IPRE_SELECT_FILE" ]]; then
            sel_lines=("${(@f)$(<"$IPRE_SELECT_FILE")}")
            sel_cnt=${#sel_lines[@]}
            sel_paths=("${sel_lines[@]}")
        fi

        print_title "Buffer Manager"
        printf "Clipboard : %b%d%b items (Op: %b%s%b)\n" "$C_MAG" "$clip_cnt" "$C_RST" "$C_MAG" "$op" "$C_RST"
        printf "Selection : %b%d%b items\n\n" "$C_YLW" "$sel_cnt" "$C_RST"
        printf "Quick Actions:\n"
        printf "  [%b p %b] Print contents    [%b t %b] Toggle COPY/CUT\n" "$C_GRN" "$C_RST" "$C_MAG" "$C_RST"
        printf "  [%b > %b] Move SEL -> CLIP  [%b < %b] Move CLIP -> SEL\n" "$C_CYN" "$C_RST" "$C_CYN" "$C_RST"
        printf "  [%b , %b] Copy SEL -> CLIP  [%b . %b] Copy CLIP -> SEL\n" "$C_YLW" "$C_RST" "$C_YLW" "$C_RST"
        printf "  [%b 1 %b] Clear Both        [%b 2 %b] Clear Clip   [%b 3 %b] Clear Sel\n" "$C_RED" "$C_RST" "$C_RED" "$C_RST" "$C_RED" "$C_RST"
        printf "  [%b s %b] Jump to SEL dir   [%b v %b] Enter Editor (or type %b:v%b / %b/vim%b)\n" "$C_CYN" "$C_RST" "$C_BLU" "$C_RST" "$C_HL" "$C_RST" "$C_HL" "$C_RST"
        printf "  [%b q %b] Exit Manager\n\n" "$C_RST" "$C_RST"

        # Hybrid key detection for vi-like commands
        read -k 1 -s "choice?Choice: " < /dev/tty
        if [[ "$choice" == ":" || "$choice" == "/" ]]; then
            printf "%s" "$choice"
            local rest
            read -r rest < /dev/tty
            choice="$choice$rest"
        fi
        case "$choice" in
            p|P)
                clear
                print_title "Buffer Contents"
                printf "[CLIPBOARD] - %b%s%b\n" "$C_MAG" "$op" "$C_RST"
                if [[ $clip_cnt -gt 0 ]]; then
                    local filepath
                    for filepath in "${clip_paths[@]}"; do
                        ipre_saved_path_decode "$filepath" || continue
                        printf "  %s\n" "$(print_hl "$REPLY")"
                    done
                else
                    printf "  (Empty)\n"
                fi
                echo ""
                printf "[SELECTION]\n"
                if [[ $sel_cnt -gt 0 ]]; then
                    local filepath
                    for filepath in "${sel_paths[@]}"; do
                        ipre_saved_path_decode "$filepath" || continue
                        printf "  %s\n" "$(print_label "$REPLY")"
                    done
                else
                    printf "  (Empty)\n"
                fi
                echo ""
                printf "Press any key to return..."
                read -k 1 -s _ < /dev/tty
                ;;
            \>)
                if [[ $sel_cnt -gt 0 ]]; then
                    # -aU ensures automatic deduplication while retaining order
                    local -aU combined=("${clip_paths[@]}" "${sel_paths[@]}")
                    printf "%s\n" "$op" "${combined[@]}" > "$IPRE_CLIP_FILE"
                    printf "" > "$IPRE_SELECT_FILE"
                fi
                ;;
            \<)
                if [[ $clip_cnt -gt 0 ]]; then
                    local -aU combined=("${sel_paths[@]}" "${clip_paths[@]}")
                    printf "%s\n" "${combined[@]}" > "$IPRE_SELECT_FILE"
                    printf "" > "$IPRE_CLIP_FILE"
                fi
                ;;
            \,)
                if [[ $sel_cnt -gt 0 ]]; then
                    local -aU combined=("${clip_paths[@]}" "${sel_paths[@]}")
                    printf "%s\n" "$op" "${combined[@]}" > "$IPRE_CLIP_FILE"
                fi
                ;;
            \.)
                if [[ $clip_cnt -gt 0 ]]; then
                    local -aU combined=("${sel_paths[@]}" "${clip_paths[@]}")
                    printf "%s\n" "${combined[@]}" > "$IPRE_SELECT_FILE"
                fi
                ;;
            1)
                printf "" > "$IPRE_CLIP_FILE"
                printf "" > "$IPRE_SELECT_FILE"
                ;;
            2)
                printf "" > "$IPRE_CLIP_FILE"
                ;;
            3)
                printf "" > "$IPRE_SELECT_FILE"
                ;;
            t|T)
                if [[ $clip_cnt -gt 0 ]]; then
                    local tmp_clip="$(mktemp)"
                    if [[ "$op" == "COPY" ]]; then
                        echo "CUT" > "$tmp_clip"
                    else
                        echo "COPY" > "$tmp_clip"
                    fi
                    printf "%s\n" "${clip_paths[@]}" >> "$tmp_clip"
                    mv -- "$tmp_clip" "$IPRE_CLIP_FILE"
                fi
                ;;
            v|V|:v|/vim)
                local tmpfile="$(mktemp)"
                local -a c_paths=() s_paths=()
                local encoded
                for encoded in "${clip_paths[@]}"; do
                    ipre_saved_path_decode "$encoded" || continue
                    ipre_text_escape "$REPLY"; c_paths+=("$REPLY")
                done
                for encoded in "${sel_paths[@]}"; do
                    ipre_saved_path_decode "$encoded" || continue
                    ipre_text_escape "$REPLY"; s_paths+=("$REPLY")
                done

                cat << EOF > "$tmpfile"
# === IPRE BUFFER INSPECTOR ===
# Modify escaped paths: \\ = backslash, \n = newline, \t = tab.
# Invalid/non-existent paths will be automatically dropped.
# Delete a line to remove it from the buffer.

[OPERATION]
# Valid values: COPY, CUT
$op

[CLIPBOARD]
$(printf "%s\n" "${c_paths[@]}")

[SELECTION]
$(printf "%s\n" "${s_paths[@]}")
EOF

                ${EDITOR:-nvim} "$tmpfile" </dev/tty >/dev/tty

                local -a tmp_lines=("${(@f)$(<"$tmpfile")}")
                local line mode="none"
                local new_op="COPY"
                local -a new_clip=() new_sel=() errors=()

                for line in "${tmp_lines[@]}"; do
                    [[ -z "$line" || "$line" == \#* ]] && continue

                    if [[ "$line" == "[OPERATION]" ]]; then mode="op"; continue; fi
                    if [[ "$line" == "[CLIPBOARD]" ]]; then mode="clip"; continue; fi
                    if [[ "$line" == "[SELECTION]" ]]; then mode="sel"; continue; fi

                    if [[ "$mode" == "op" ]]; then
                        local parsed_op="${line:u}"
                        if [[ "$parsed_op" == "CUT" || "$parsed_op" == "COPY" ]]; then
                            new_op="$parsed_op"
                        else
                            errors+=("Invalid operation '$line'. Defaulted to COPY.")
                        fi
                    elif [[ "$mode" == "clip" || "$mode" == "sel" ]]; then
                        if ipre_text_unescape "$line" && [[ -e "$REPLY" || -L "$REPLY" ]]; then
                            ipre_path_encode "${REPLY:a}"
                            [[ "$mode" == "clip" ]] && new_clip+=("$REPLY")
                            [[ "$mode" == "sel" ]] && new_sel+=("$REPLY")
                        else
                            errors+=("Dropped invalid/missing path: $line")
                        fi
                    fi
                done

                if [[ ${#new_clip[@]} -gt 0 ]]; then
                    printf "%s\n" "$new_op" "${new_clip[@]}" > "$IPRE_CLIP_FILE"
                else
                    printf "" > "$IPRE_CLIP_FILE"
                fi

                if [[ ${#new_sel[@]} -gt 0 ]]; then
                    printf "%s\n" "${new_sel[@]}" > "$IPRE_SELECT_FILE"
                else
                    printf "" > "$IPRE_SELECT_FILE"
                fi

                rm -f -- "$tmpfile"

                if [[ ${#errors[@]} -gt 0 ]]; then
                    {
                        printf "\033[?1049h\033[2J\033[H"
                        print_warn "Inspector Finished with Notices"
                        local err
                        for err in "${errors[@]}"; do
                            ipre_text_escape "$err"
            printf "  %b- %s%b\n" "$C_YLW" "$REPLY" "$C_RST"
                        done
                        echo ""
                        printf "Press any key to return..."
                    } > /dev/tty
                    read -k 1 -s _ < /dev/tty
                    printf "\033[?1049l" > /dev/tty
                fi

                # Exit loop and return to UI after editor is closed
                break
                ;;
            s|S)
                # NOTE: Call the temporary shared(bookmark) jumper
                #       If it returns 0 (success), break the loop to return to main UI.
                if ipre_action_jump_from_list "$IPRE_SELECT_FILE" "Selection" ""; then
                    break
                fi
                ;;
            q|Q|$'\n'|$'\r')
                break
                ;;
            *)
                # Unmapped key pressed, simply redraw the manager UI
                ;;
        esac
    done
}

#####     yank path     #####
ipre_action_yank_path() {
    cd "$IPRE_CWD" || exit 0
    local item
    local -a paths=()
    for item in "$@"; do
        paths+=("${item:a}")
    done
    if [[ ${#paths[@]} -gt 0 ]]; then
        printf "%s\n" "${paths[@]}" | ${CLIPBOARD:-wl-copy}
    fi
}

#####     ipre bookmark     #####
ipre_action_bookmark() {
    cd "$IPRE_CWD" || exit 0
    [[ $# -eq 0 || -z "$1" ]] && exit 0

    touch "$IPRE_BOOKMARKS_FILE"
    local -a bookmarks=("${(@f)$(<"$IPRE_BOOKMARKS_FILE")}")

    local i target
    for i in "$@"; do
        ipre_path_encode "${i:a}"
        target="$REPLY"
        if [[ -z "${bookmarks[(r)$target]}" ]]; then
            printf '%s\n' "$target" >> "$IPRE_BOOKMARKS_FILE"
            bookmarks+=("$target")
        fi
    done
}

ipre_action_open_bookmarks() {
    ipre_action_jump_from_list "$IPRE_BOOKMARKS_FILE" "Bookmarks" "Please use $(print_hl "Alt+s") to bookmark existing files/directories first."
}

# Smart Diff (Requires exactly 2 files in Selection Buffer)
ipre_action_smart_diff() {
    cd "$IPRE_CWD" || exit 0
    enter_alt_screen
    if [[ ! -s "$IPRE_SELECT_FILE" ]]; then
        print_warn "Selection buffer is empty. Mark 2 files first."
        printf "Press any key to return..."
        read -k 1 -s _ < /dev/tty
        leave_alt_screen
        exit 0
    fi
    local -a sel_lines=("${(@f)$(<"$IPRE_SELECT_FILE")}")
    if [[ ${#sel_lines[@]} -ne 2 ]]; then
        print_warn "Smart Diff requires EXACTLY 2 files. You selected ${#sel_lines[@]}."
        printf "Press any key to return..."
        read -k 1 -s _ < /dev/tty
        leave_alt_screen
        exit 0
    fi
    ipre_saved_path_decode "${sel_lines[1]}" || return 1
    local file1="$REPLY"
    ipre_saved_path_decode "${sel_lines[2]}" || return 1
    local file2="$REPLY"
    if [[ ! -f "$file1" || ! -f "$file2" ]]; then
        print_warn "Both targets must be valid files, not directories."
        printf "Press any key to return..."
        read -k 1 -s _ < /dev/tty
        leave_alt_screen
        exit 0
    fi
    ${EDITOR:-nvim} -d "$file1" "$file2" </dev/tty >/dev/tty
    # Clear the buffer after successful diffing
    printf "" > "$IPRE_SELECT_FILE"
    leave_alt_screen
}

# rg's NUL separates the filename from line:column:text. Only the first two
# colons in that second part are metadata; filenames and contents stay intact.
ipre_action_rg_stream() {
    [[ -n "$1" ]] || return 0
    cd -- "$IPRE_CWD" || return 1
    local filepath rest number column content label key IPRE_INPUT_BUFFER=""
    rg --column --line-number --with-filename --no-heading --color=never --smart-case --null -- "$1" . 2>/dev/null | while ipre_stream_read $'\0'; do
        filepath="$REPLY"
        ipre_stream_read $'\n' || break
        rest="$REPLY"
        number="${rest%%:*}"; rest="${rest#*:}"
        column="${rest%%:*}"; content="${rest#*:}"
        [[ "$number" == <-> && "$column" == <-> ]] || continue
        filepath="${filepath:a}"
        ipre_path_encode "$filepath"; key="$REPLY"
        ipre_display_path "$filepath"; label="$REPLY"
        ipre_text_escape "$content"
        printf '%s\t%s\t%s\t%s:%s:%s:%s\n' "$key" "$number" "$column" "$label" "$number" "$column" "$REPLY"
    done
    return 0
}

ipre_action_rg_preview() {
    [[ -f "$1" && "$2" == <-> ]] || return 1
    if command -v bat >/dev/null; then
        bat --color=always --style=numbers --highlight-line "$2" -- "$1"
    else
        cat -- "$1"
    fi
}

ipre_action_live_grep() {
    command -v rg >/dev/null || return 1
    enter_alt_screen
    {
        local backend="${(q)IPRE_BACKEND_CMD}" selected line filepath key
        local -a unique_keys=()
        selected=$(
            fzf -m --prompt 'Ripgrep > ' --disabled --layout=reverse \
                --delimiter=$'\t' --with-nth=4 \
                --bind "start:reload:$backend ipre_action_rg_stream -- {q}" \
                --bind "change:reload:$backend ipre_action_rg_stream -- {q}" \
                --bind 'alt-f:unbind(change)+change-prompt(Fuzzy > )+enable-search+clear-query' \
                --bind "alt-r:rebind(change)+change-prompt(Ripgrep > )+disable-search+clear-query+reload($backend ipre_action_rg_stream -- {q})" \
                --bind 'alt-a:select-all' --bind 'alt-d:deselect-all' \
                --bind 'ctrl-f:preview-half-page-down' --bind 'ctrl-b:preview-half-page-up' \
                --preview "$backend ipre_action_rg_preview --encoded {1} {2}" \
                --preview-window 'right:50%,border-left,+{2}-/2' < /dev/tty
        )
        [[ -n "$selected" ]] || return 0
        local -A seen=()
        for line in "${(@f)selected}"; do
            ipre_record_path "$line" || continue
            filepath="$REPLY"
            [[ -e "$filepath" || -L "$filepath" ]] || continue
            key="${line%%$'\t'*}"
            [[ -n "${seen[$key]}" ]] && continue
            seen[$key]=1; unique_keys+=("$key")
        done
        (( ${#unique_keys[@]} )) || return 0
        ipre_saved_path_decode "${unique_keys[1]}" || return 1
        filepath="$REPLY"
        ipre_set_cwd "${filepath:h}"
        ipre_set_focus "$filepath"
        printf 'all\n' > "$IPRE_STATE_FILE"
        : > "$IPRE_TARGETS_FILE"
        if (( ${#unique_keys[@]} > 1 )); then
            touch "$IPRE_SELECT_FILE"
            local -aU merged=()
            [[ -s "$IPRE_SELECT_FILE" ]] && merged=("${(@f)$(<"$IPRE_SELECT_FILE")}")
            merged+=("${unique_keys[@]}")
            printf '%s\n' "${merged[@]}" > "$IPRE_SELECT_FILE"
        fi
    } always {
        leave_alt_screen
    }
}

ipre_action_zoxide() {
    if ! command -v zoxide &> /dev/null; then
        enter_alt_screen
        print_warn "Zoxide is not installed."
        printf "Press any key to return..."
        leave_alt_screen
        exit 0
    fi

    enter_alt_screen
    local selected
    selected=$(
        zoxide query -l | while IFS= read -r value; do
            [[ -d "$value" ]] && ipre_emit_record "$value"
        done | fzf --prompt 'Zoxide> ' --reverse --delimiter=$'\t' --with-nth=2 \
            --preview "${(q)IPRE_BACKEND_CMD} ipre_action_preview_with_page --encoded {1}" --preview-window 'right:50%,border-left'
    )
    leave_alt_screen

    if [[ -n "$selected" ]] && ipre_record_path "$selected" && [[ -d "$REPLY" ]]; then
        ipre_set_cwd "$REPLY"
        echo 'all' > "$IPRE_STATE_FILE"
        printf "" > "$IPRE_TARGETS_FILE"
        # Explicitly clear RAM focus to avoid jumping to a non-existent file in the new directory
        rm -f -- "$IPRE_RAM_FOCUS_FILE"
    fi
}

