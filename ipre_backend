#!/usr/bin/env zsh

setopt extended_glob

ACTION="$1"
ITEM="$2"
shift # Shift out the action, so "$@" contains the target files if any


# =========================================================
# ipre_backend bootstrap
# =========================================================

# Global Icon Sanitization
# NOTE: Strip the leading icon and space from all incoming targets
if [[ "$IPRE_ICONS" == "1" ]]; then
    ITEM="${ITEM#* }"
    local -a clean_args=()
    local arg
    for arg in "$@"; do
        clean_args+=("${arg#* }")
    done
    set -- "${clean_args[@]}" # Re-inject sanitized arguments back to $@
fi

# Clip & Select Buffer Merge
if [[ "$ACTION" == "ipre_action_command_palette" ]]; then
    if [[ -s "$IPRE_SELECT_FILE" ]]; then
        local -a sel_args=("${(@f)$(<"$IPRE_SELECT_FILE")}")
        set -- "$@" "${sel_args[@]}"
        local -A seen_args
        local -a final_args=()
        for arg in "$@"; do
            if [[ -z "${seen_args[$arg]}" ]]; then
                final_args+=("$arg")
                seen_args[$arg]=1
            fi
        done
        set -- "${final_args[@]}"
    fi
fi

# Load external modules
source "${0:A:h}/ipre_palette"

# Semantic UI Constants
readonly C_RST='\033[0m'
readonly C_RED='\033[1;31m'
readonly C_GRN='\033[1;32m'
readonly C_YLW='\033[1;33m'
readonly C_CYN='\033[1;36m'
readonly C_MAG='\033[1;35m'

print_title()  { printf "%b=== %s ===%b\n" "$C_CYN" "$1" "$C_RST"; }
print_warn()   { printf "%b=== %s ===%b\n\n" "$C_RED" "$1" "$C_RST"; }
print_label()  { printf "%b%s%b" "$C_GRN" "$1" "$C_RST"; }
print_hl()     { printf "%b%s%b" "$C_YLW" "$1" "$C_RST"; }
print_clip()   { printf "[%b%s: %d%b] " "$C_MAG" "$1" "$2" "$C_RST"; }

# alternate screen
enter_alt_screen_init() {
    printf '\033[?1049h' > /dev/tty
}
enter_alt_screen() {
    # enter + clear + cursor(1, 1)
    printf "\033[?1049h\033[2J\033[H" > /dev/tty
}
leave_alt_screen() {
    printf '\033[?1049l' > /dev/tty
}


# =========================================================
# Core Command Implementations
# =========================================================

#####     status bar & header info     #####
ipre_action_border_status() {
    local targets="$(<"$IPRE_TARGETS_FILE")"
    local cwd clip_str depth depth_str git_str

    # entry mode & cwd
    local state="$(<"$IPRE_STATE_FILE")"
    if [[ -n "$targets" ]]; then
        cwd="[Multiple Directories]"
    else
        cwd="$(<"$IPRE_CWD_FILE")"
        cwd="${cwd/#$HOME/~}"
    fi
    local entry_mode_cwd="$(printf '[%b%s%b:%s]' "$C_CYN" "$state" "$C_RST" "$cwd")"

    # clip|select status
    local border_tag="" clip_cnt=0 sel_cnt=0 op=""
    if [[ -s "$IPRE_CLIP_FILE" ]]; then
        local -a clip_lines=("${(@f)$(<"$IPRE_CLIP_FILE")}")
        clip_cnt=$(( ${#clip_lines[@]} - 1 ))
        op="${clip_lines[1]}"
    fi
    if [[ -s "$IPRE_SELECT_FILE" ]]; then
        local -a sel_lines=("${(@f)$(<"$IPRE_SELECT_FILE")}")
        sel_cnt=${#sel_lines[@]}
    fi
    if [[ $clip_cnt -gt 0 || $sel_cnt -gt 0 ]]; then
        border_tag="["
        [[ $clip_cnt -gt 0 ]] && border_tag+="$(printf '%b%s:%d%b' "$C_MAG" "$op" "$clip_cnt" "$C_RST")"
        [[ $clip_cnt -gt 0 && $sel_cnt -gt 0 ]] && border_tag+="|"
        [[ $sel_cnt -gt 0 ]] && border_tag+="$(printf '%bSEL:%d%b' "$C_YLW" "$sel_cnt" "$C_RST")"
        border_tag+="]"
    fi
    clip_str="$border_tag"

    # max dir depth
    depth="$(<"$IPRE_RAM_DEPTH_FILE" 2>/dev/null)"
    depth_str=""
    if [[ -n "$depth" && "$depth" -gt 0 ]]; then
        depth_str="$(printf '[%bDepth:%s%b]' "$C_YLW" "$depth" "$C_RST")"
    elif [[ "$depth" == "0" ]]; then
        depth_str="$(printf '[%bDepth:oo%b]' "$C_YLW" "$C_RST")"
    fi

    # git status
    git_str=""
    if git -C "$(<"$IPRE_CWD_FILE")" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        local branch="$(git -C "$(<"$IPRE_CWD_FILE")" branch --show-current 2>/dev/null)"
        local changes="$(git -C "$(<"$IPRE_CWD_FILE")" status --porcelain 2>/dev/null | wc -l)"
        if [[ "$changes" -gt 0 ]]; then
            git_str="$(printf '[%bGit:%s *%d%b]' "$C_MAG" "$branch" "$changes" "$C_RST")"
        else
            git_str="$(printf '[%bGit:%s%b]' "$C_GRN" "$branch" "$C_RST")"
        fi
    fi

    # sort mode
    local sort_mode="$(<"$IPRE_SORT_FILE" 2>/dev/null)"
    local sort_str="$(printf '[%bSort:%s%b]' "$C_YLW" "${sort_mode:-name}" "$C_RST")"

    # help info
    local help_info="$(printf '[%b%s%b]' "$C_GRN" "HELP:M+?|ESC:C-g" "$C_RST")"

    printf '%s%s%s%s%s%s' "$help_info" "$git_str" "$sort_str" "$depth_str" "$clip_str" "$entry_mode_cwd"
}

ipre_action_header_info() {
    cd "$(<"$IPRE_CWD_FILE")" || exit 0
    local info
    if [[ -n "$ITEM" && -f "$ITEM" ]]; then
        local du_out="$(du -sh "$ITEM" 2>/dev/null)"
        local size="${du_out%%[[:space:]]*}"
        info="$(printf '[%b%s%b]: %s' "$C_YLW" "$size" "$C_RST" "$(file --brief "$ITEM" 2>/dev/null)")"
    elif [[ -n "$ITEM" ]]; then
        info="$(file --brief "$ITEM" 2>/dev/null || echo 'No file')"
    else
        info="Empty directory / No matches"
    fi
    printf '%s\n' "$info"
}


#####     list entry(kernel)     #####
ipre_action_run_eza() {
    cd "$(<"$IPRE_CWD_FILE")" || exit 0
    local run_cmd="$IPRE_FD_CMD_STR"
    local targets="$(<"$IPRE_TARGETS_FILE")"
    if [[ "$(<"$IPRE_HIDDEN_FILE")" == "true" ]]; then
        run_cmd="$run_cmd --hidden"
    fi
    local depth="$(<"$IPRE_RAM_DEPTH_FILE" 2>/dev/null)"
    if [[ -n "$depth" && "$depth" -gt 0 ]]; then
        run_cmd="$run_cmd --maxdepth $depth"
    fi

    # sort command
    local sort_mode="$(<"$IPRE_SORT_FILE" 2>/dev/null)"
    local eza_opts="-1d --color=never --no-quotes"
    [[ "$IPRE_ICONS" == "1" ]] && eza_opts+=" --icons=always"
    case "$sort_mode" in
        time) eza_opts+=" --sort=modified --reverse" ;; # Newest first
        size) eza_opts+=" --sort=size --reverse" ;;     # Largest first
        ext)  eza_opts+=" --sort=extension" ;;          # By extension
        *)    eza_opts+=" --sort=name" ;;               # Case-insensitive natural sort
    esac

    # fd filter
    # NOTE: call different process according to entry mode('all', 'file' or 'directory')
    local state="$(<"$IPRE_STATE_FILE")"
    run_fd_eza_stream() {
        local type_flag="$1"
        local append_slash="$2"
        local full_cmd="$run_cmd --type $type_flag $targets -X eza $=eza_opts"
        # NOTE: "sed 's/ -> .*//'" to remove soft link target
        if [[ "$append_slash" == "true" ]]; then
            eval "$full_cmd" 2>/dev/null | sed 's/ -> .*//' | sed 's|^\./||; s|^\([^ ]* \)\./|\1|; s|/\?$|/|'
        else
            eval "$full_cmd" 2>/dev/null | sed 's/ -> .*//' | sed 's|^\./||; s|^\([^ ]* \)\./|\1|'
        fi
    }
    if [[ "$state" == "directory" ]]; then
        run_fd_eza_stream "d" "true" || true
    elif [[ "$state" == "file" ]]; then
        run_fd_eza_stream "f" "false" || true
    else
        run_fd_eza_stream "d" "true" || true
        run_fd_eza_stream "f" "false" || true
    fi
}
ipre_action_run_ls() {
    cd "$(<"$IPRE_CWD_FILE")" || exit 0
    local run_cmd="$IPRE_FD_CMD_STR"
    local targets="$(<"$IPRE_TARGETS_FILE")"
    if [[ "$(<"$IPRE_HIDDEN_FILE")" == "true" ]]; then
        run_cmd="$run_cmd --hidden"
    fi
    local depth="$(<"$IPRE_RAM_DEPTH_FILE" 2>/dev/null)"
    if [[ -n "$depth" && "$depth" -gt 0 ]]; then
        run_cmd="$run_cmd --maxdepth $depth"
    fi

    # fd filter
    local state="$(<"$IPRE_STATE_FILE")"
    if [[ "$state" == "directory" ]]; then
        run_cmd="$run_cmd --type d"
    elif [[ "$state" == "file" ]]; then
        run_cmd="$run_cmd --type f"
    fi

    # sort command
    run_cmd="$run_cmd $targets"
    local sort_mode="$(<"$IPRE_SORT_FILE" 2>/dev/null)"
    local sort_cmd="-X ls -1dp --group-directories-first"
    case "$sort_mode" in
        time) sort_cmd+=" -t" ;;
        size) sort_cmd+=" -S" ;;
        ext)  sort_cmd+=" -X" ;; # '-X' must be the last
        *)    sort_cmd+=" -v" ;;
    esac
    run_cmd="$run_cmd $sort_cmd"
    if [[ "$IPRE_ICONS" == "1" ]]; then
        # inject 'd' for directory, '-' for file
        eval "$run_cmd" 2>/dev/null | sed 's|^\./||; /\/$/ s|^|d |; /\/$/! s|^|- |' || true
    else
        eval "$run_cmd" 2>/dev/null | sed 's|^\./||' || true
    fi
}
ipre_action_run() {
    if [[ "$IPRE_USE_LS" == "1" ]]; then
        ipre_action_run_ls
    else
        ipre_action_run_eza
    fi
}


#####  Page-Flipping Preview Engine   #####
ipre_action_change_page() {
    local opt="$1"
    local current=1
    [[ -f "$IPRE_PAGE_FILE" ]] && current=$(<"$IPRE_PAGE_FILE")
    if [[ "$opt" == "next" ]]; then
        ((current++))
    elif [[ "$opt" == "prev" ]]; then
        ((current--))
    fi
    if (( current < 1 )); then
        echo 1 > "$IPRE_PAGE_FILE"
        return 0
    fi

    # Cache page_max
    local page_max=""
    cd "$(<"$IPRE_CWD_FILE")" || exit 0
    if [[ -s "$IPRE_PAGE_MAX_FILE" ]]; then
        page_max=$(<"$IPRE_PAGE_MAX_FILE")
    else
        local file=""
        [[ -f "$IPRE_LAST_FILE" ]] && file="$(<"$IPRE_LAST_FILE")"
        if [[ -n "$file" && -f "$file" ]]; then
            local ext="${file:l:e}"
            local file_type
            file_type=$(pre get_file_type "$file" "$ext" 2>/dev/null)
            case "$file_type" in
                pdf)  page_max=$(pdfinfo "$file" 2>/dev/null | awk '/^Pages:/ {print $2}') ;;
                djvu) page_max=$(djvused -e 'n' "$file" 2>/dev/null) ;;
            esac
        fi
        # Fallback: empty, non-numeric
        [[ -z "$page_max" || ! "$page_max" =~ ^[0-9]+$ ]] && page_max=999999
        echo "$page_max" > "$IPRE_PAGE_MAX_FILE"
    fi
    if (( current > page_max )); then 
        echo "$page_max" > "$IPRE_PAGE_FILE"
    else
        echo "$current" > "$IPRE_PAGE_FILE"
    fi
}

ipre_action_preview_with_page() {
    printf '\033[2J\033[H'
    local target="$1"
    [[ "$IPRE_ICONS" == "1" ]] && target="${target#* }" 
    local file="$target"
    local page=1
    local last_file_name=""
    [[ -f "$IPRE_LAST_FILE" ]] && last_file_name=$(<"$IPRE_LAST_FILE")

    if [[ "$file" != "$last_file_name" ]]; then
        echo 1 > "$IPRE_PAGE_FILE"
        printf "" > "$IPRE_PAGE_MAX_FILE"
        echo "$file" > "$IPRE_LAST_FILE"
        page=1
    else
        [[ -f "$IPRE_PAGE_FILE" ]] && page=$(<"$IPRE_PAGE_FILE")
    fi
    cd "$(<"$IPRE_CWD_FILE")" || exit 0
    pre "$file" "PAGE:$page" 2>/dev/null
}

# Smart Scroll Dispatcher (FZF Transform Protocol)
ipre_action_smart_scroll() {
    local dir="$1"
    local target="$2"
    [[ "$IPRE_ICONS" == "1" ]] && target="${target#* }"
    local file="$target"
    local ext="${file:l:e}"
    local file_type
    file_type=$(pre get_file_type "$file" "$ext" 2>/dev/null)
    if [[ "$file_type" == "pdf" || "$file_type" == "djvu" ]]; then
        if [[ "$dir" == "down" ]]; then
            ipre_action_change_page next
        else
            ipre_action_change_page prev
        fi
        echo "refresh-preview"
    else
        if [[ "$dir" == "down" ]]; then
            echo "preview-half-page-down"
        else
            echo "preview-half-page-up"
        fi
    fi
}


#####     simple entry operation     #####
ipre_action_sort_cycle() {
    local cur="$(<"$IPRE_SORT_FILE")"
    case "$cur" in
        name) echo "time" > "$IPRE_SORT_FILE" ;;
        time) echo "size" > "$IPRE_SORT_FILE" ;;
        size) echo "ext"  > "$IPRE_SORT_FILE" ;;
        ext)  echo "name" > "$IPRE_SORT_FILE" ;;
        *)    echo "name" > "$IPRE_SORT_FILE" ;;
    esac
}

ipre_action_set_depth() {
    local new_val="$ITEM"
    local cur="$(<"$IPRE_RAM_DEPTH_FILE" 2>/dev/null)"
    [[ -z "$cur" ]] && cur=0

    if [[ "$new_val" == "+" ]]; then
        echo $((cur + 1)) > "$IPRE_RAM_DEPTH_FILE"
    elif [[ "$new_val" == "-" ]]; then
        if [[ "$cur" -gt 0 ]]; then
            echo $((cur - 1)) > "$IPRE_RAM_DEPTH_FILE"
        fi
    else
        echo "$new_val" > "$IPRE_RAM_DEPTH_FILE"
    fi
}

ipre_action_switch() {
    local state="$(<"$IPRE_STATE_FILE")"
    if [[ "$state" == "file" ]]; then
        echo 'directory' > "$IPRE_STATE_FILE"
    elif [[ "$state" == "directory" ]]; then
        echo 'all' > "$IPRE_STATE_FILE"
    else
        echo 'file' > "$IPRE_STATE_FILE"
    fi
    ipre_action_run
}

ipre_action_hidden() {
    if [[ "$(<"$IPRE_HIDDEN_FILE")" == "true" ]]; then
        echo 'false' > "$IPRE_HIDDEN_FILE"
    else
        echo 'true' > "$IPRE_HIDDEN_FILE"
    fi
}


#####     Entry list navigation     #####
ipre_action_refresh_and_focus() {
    if [[ ! -f "$IPRE_RAM_FOCUS_FILE" ]]; then
        # Use explicitly exported backend cmd to survive subshell context loss
        echo "reload(\"$IPRE_BACKEND_CMD\" ipre_action_run)"
        exit 0
    fi

    local focus_target="$(<"$IPRE_RAM_FOCUS_FILE")"
    rm -f -- "$IPRE_RAM_FOCUS_FILE"
    if [[ -z "$focus_target" ]]; then
        echo "reload(\"$IPRE_BACKEND_CMD\" ipre_action_run)"
        exit 0
    fi

    ipre_action_run > "$IPRE_RAM_LIST_FILE" 2>/dev/null
    local line_num="$(awk -v ic="$IPRE_ICONS" -v t="$focus_target" '{
        str = $0;
        if(ic == "1") sub(/^[^ ]+ /, "", str);
        if(str == t || str == t"/") {print NR; exit}
    }' "$IPRE_RAM_LIST_FILE")"
    if [[ -n "$line_num" ]]; then
        echo "$line_num" > "$IPRE_RAM_POS_FILE"
    fi
    echo "reload-sync(cat '$IPRE_RAM_LIST_FILE')+clear-query"
}

ipre_action_left() {
    local cur="$(<"$IPRE_CWD_FILE")"
    local parent="${cur:h}"
    [[ -z "$parent" ]] && parent="/"

    if [[ "$cur" == "$parent" ]]; then
        echo "reload(\"$IPRE_BACKEND_CMD\" ipre_action_run)+clear-query"
        exit 0
    fi

    local target_name="${cur:t}"
    echo "$parent" > "$IPRE_CWD_FILE"
    echo 'all' > "$IPRE_STATE_FILE"
    printf "" > "$IPRE_TARGETS_FILE"

    ipre_action_run > "$IPRE_RAM_LIST_FILE" 2>/dev/null
    local line_num="$(awk -v ic="$IPRE_ICONS" -v t="$target_name" '{
        str = $0;
        if(ic == "1") sub(/^[^ ]+ /, "", str);
        if(str == t || str == t"/") {print NR; exit}
    }' "$IPRE_RAM_LIST_FILE")"

    [[ -n "$line_num" ]] && echo "$line_num" > "$IPRE_RAM_POS_FILE"
    echo "reload-sync(cat '$IPRE_RAM_LIST_FILE')+clear-query"
}

ipre_action_right() {
    local cur="$(<"$IPRE_CWD_FILE")"
    cd "$cur" || exit 0
    if [[ -n "$ITEM" ]]; then
        local target_path new
        if [[ "$ITEM" == /* ]]; then
            target_path="$ITEM"
        else
            target_path="$cur/$ITEM"
        fi

        if [[ -d "$target_path" ]]; then
            new="$(realpath -s "$target_path")"
        else
            new="$(realpath -s "${target_path:h}")"
        fi
        [[ -z "$new" ]] && new="$cur"
        echo "$new" > "$IPRE_CWD_FILE"
    fi
    echo 'all' > "$IPRE_STATE_FILE"
    printf "" > "$IPRE_TARGETS_FILE"
    ipre_action_run || true
}


#####     Modify entry: select|create|copy|cut|delete|rename etc     #####
ipre_action_mark() {
    cd "$(<"$IPRE_CWD_FILE")" || exit 0
    [[ $# -eq 0 || -z "$1" ]] && exit 0

    touch "$IPRE_SELECT_FILE"
    local i target
    for i in "$@"; do
        target="$(realpath -s "$i")"
        echo "$target" >> "$IPRE_SELECT_FILE"
    done
    local -a dedup=("${(@f)$(awk '!seen[$0]++' "$IPRE_SELECT_FILE")}")
    printf "%s\n" "${dedup[@]}" > "$IPRE_SELECT_FILE"
}

ipre_action_new() {
    cd "$(<"$IPRE_CWD_FILE")" || exit 0
    clear
    print_title "Create New"
    printf 'Current Dir : %s\n' "$(print_label "$PWD")"
    printf 'Syntax Hint : End with %s to create a directory.\n' "$(print_hl "/")"
    printf 'Tokenize    : No need to quote spaces; single quotes are literal and not stripped\n'
    printf 'Multiple    : Separate with commas (e.g., file1, dir2/, dir3/file3)\n'
    printf 'Cancel      : Clear input (%s) and press %s (or type %s)\n' "$(print_hl "Ctrl+U")" "$(print_hl "Enter")" "$(print_hl ":q")"
    printf 'Batch Mode  : Type %s or %s and press Enter to open Vim\n\n' "$(print_hl ":v")" "$(print_hl "/vim")"

    local names="" tmpfile tmp_lines name_array name
    if ! vared -p "Enter name(s): " names </dev/tty; then
        echo ""
        return 0
    fi
    if [[ -z "$names" || "$names" == ":q" || "$names" == "/q" ]]; then
        exit 0
    elif [[ "$names" == ":v" || "$names" == "/vim" ]]; then
        tmpfile="$(mktemp)"
        cat << 'EOF2' > "$tmpfile"
# === Batch Create Files & Directories ===
# 1. Write one item per line.
# 2. End with '/' to create a directory (e.g., src/components/ )
# 3. Lines starting with '#' or empty lines will be ignored.
# 4. No need to quote spaces; single quotes are literal and not stripped.
# 5. Save and exit (:wq) to apply. Delete all lines or exit without saving (:q!) to cancel.

EOF2
        ${EDITOR:-nvim} "$tmpfile" </dev/tty >/dev/tty
        tmp_lines=("${(@f)$(<"$tmpfile")}")
        for name in "${tmp_lines[@]}"; do
            name="${name## #}"
            name="${name%% #}"
            [[ -z "$name" || "$name" == \#* ]] && continue
            [[ ! -f "$IPRE_RAM_FOCUS_FILE" ]] && echo "$name" > "$IPRE_RAM_FOCUS_FILE"
            case "$name" in
                */) mkdir -p "$name" ;;
                *)  mkdir -p "${name:h}"; touch "$name" ;;
            esac
        done
        rm -f -- "$tmpfile"
    else
        name_array=("${(@s/,/)names}")
        for name in "${name_array[@]}"; do
            name="${name## #}"
            name="${name%% #}"
            [[ -z "$name" ]] && continue
            [[ ! -f "$IPRE_RAM_FOCUS_FILE" ]] && echo "$name" > "$IPRE_RAM_FOCUS_FILE"
            case "$name" in
                */) mkdir -p "$name" ;;
                *)  mkdir -p "${name:h}"; touch "$name" ;;
            esac
        done
    fi
}

ipre_action_copy() {
    cd "$(<"$IPRE_CWD_FILE")" || exit 0
    [[ $# -eq 0 || -z "$1" ]] && exit 0
    echo "COPY" > "$IPRE_CLIP_FILE"
    local i
    for i in "$@"; do realpath -s "$i" >> "$IPRE_CLIP_FILE"; done
}

ipre_action_cut() {
    cd "$(<"$IPRE_CWD_FILE")" || exit 0
    [[ $# -eq 0 || -z "$1" ]] && exit 0
    echo "CUT" > "$IPRE_CLIP_FILE"
    local i
    for i in "$@"; do realpath -s "$i" >> "$IPRE_CLIP_FILE"; done
}

ipre_action_paste() {
    [[ ! -s "$IPRE_CLIP_FILE" ]] && exit 0
    local dest="$(<"$IPRE_CWD_FILE")"
    local -a clip_lines=("${(@f)$(<"$IPRE_CLIP_FILE")}")
    local op="${clip_lines[1]}"

    # Declarations hoisted to avoid in-loop evaluation printing
    local src base target name ext counter
    for src in "${clip_lines[@]:1}"; do
        [[ -z "$src" || ! -e "$src" ]] && continue

        base="${src:t}"
        target="$dest/$base"
        if [[ -e "$target" ]]; then
            [[ "$op" == "CUT" && "$src" == "$target" ]] && continue

            name="${base:r}"
            ext="${base:e}"
            if [[ -z "$name" ]]; then
                name="$base"
                ext=""
            else
                [[ -n "$ext" ]] && ext=".$ext"
            fi

            counter=1
            while [[ -e "$dest/${name}_copy${counter}${ext}" ]]; do
                ((counter++))
            done
            target="$dest/${name}_copy${counter}${ext}"
        fi

        if [[ "$op" == "COPY" ]]; then
            cp -r -- "$src" "$target"
        elif [[ "$op" == "CUT" ]]; then
            mv -- "$src" "$target"
        fi

        if [[ ! -f "$IPRE_RAM_FOCUS_FILE" ]]; then
            echo "${target:t}" > "$IPRE_RAM_FOCUS_FILE"
        fi
    done

    if [[ "$op" == "CUT" ]]; then
        printf "" > "$IPRE_CLIP_FILE"
    fi
}

ipre_action_delete() {
    cd "$(<"$IPRE_CWD_FILE")" || exit 0
    [[ $# -eq 0 || -z "$1" ]] && exit 0
    clear

    print_warn "WARNING: SAFE TRASH CONFIRMATION"
    printf "Current Dir : %s\n" "$(print_label "$PWD")"
    printf "Are you sure you want to move the following %d item(s) to the hidden trash bin?\n" "$#"

    local i base ts
    for i in "$@"; do
        printf "  %s\n" "$(print_hl "$i")"
    done
    printf "\nType \"y\" to confirm [y/N]: "

    local ans
    read -r ans </dev/tty
    if [[ "$ans" == "y" || "$ans" == "Y" ]]; then
        ts=$(date +%s)
        for i in "$@"; do
            base="${i:t}"
            mv -- "$i" "$IPRE_TRASH_DIR/${base}___${ts}"
        done
        clear
        printf "%bSuccessfully moved to trash.%b\n" "$C_GRN" "$C_RST"
        sleep 0.5
    fi
}

ipre_action_rename() {
    cd "$(<"$IPRE_CWD_FILE")" || exit 0
    [[ $# -eq 0 || -z "$1" ]] && exit 0
    clear
    print_title "Rename"
    printf 'Current Dir : %s\n' "$(print_label "$PWD")"
    printf 'Cancel/Skip : Clear input (%s) and press %s\n' "$(print_hl "Ctrl+U")" "$(print_hl "Enter")"
    printf 'Abort Batch : Type %s or %s and press Enter\n\n' "$(print_hl ":q")" "$(print_hl "/q")"

    local item old_name new_name clean_new target_dir val
    for item in "$@"; do
        [[ ! -e "$item" ]] && continue
        old_name="${item:t}"

        # Use a safe Bash subshell to retain the `read -e -i` pre-fill behavior flawlessly
        val=$(bash -c 'read -e -i "$1" -p "Rename '\''$1'\'' to: " ans </dev/tty && echo "$ans"' _ "$old_name")
        new_name="$val"

        # Explicitly abort the entire batch process
        [[ "$new_name" == ":q" || "$new_name" == "/q" ]] && break
        # Skip empty inputs
        [[ -z "$new_name" ]] && continue

        if [[ -f "$old_name" ]]; then
            case "$new_name" in
                */)
                    printf "%b[Error] Cannot rename a file to a path ending with '/'.%b\n" "$C_RED" "$C_RST"
                    sleep 1.5
                    continue
                    ;;
            esac
        fi

        clean_new="${new_name%%/##}"
        [[ "$clean_new" == "$old_name" ]] && continue
        if [[ -e "$clean_new" ]]; then
            printf "%b[Error] '%s' already exists. Skipping.%b\n" "$C_RED" "$clean_new" "$C_RST"
            sleep 1.5
            continue
        fi

        target_dir="${clean_new:h}"
        if [[ "$target_dir" != "." && ! -d "$target_dir" ]]; then
            mkdir -p "$target_dir"
        fi
        mv -- "$old_name" "$clean_new"
        if [[ ! -f "$IPRE_RAM_FOCUS_FILE" ]]; then
            echo "${clean_new:t}" > "$IPRE_RAM_FOCUS_FILE"
        fi
    done
}

# FIXME: This function is potentially unsafe; there may be edge cases I haven't accounted for.
ipre_action_wdired() {
    cd "$(<"$IPRE_CWD_FILE")" || exit 0
    [[ $# -eq 0 || -z "$1" ]] && exit 0
    local tmpfile="$(mktemp)"

    cat << 'EOF' > "$tmpfile"
# === Wdired Batch Rename ===
# Edit the names on the RIGHT side of the arrow ( -> ).
# DO NOT change the left side, delete lines, or reorder them.
# Save and exit to apply. Delete all text to abort.
# WARN: This function is potentially unsafe; there may be edge cases I haven't accounted for.

EOF

    local item old_name
    for item in "$@"; do
        [[ ! -e "$item" ]] && continue
        old_name="${item:t}"
        printf "%s -> %s\n" "$old_name" "$old_name" >> "$tmpfile"
    done
    ${EDITOR:-nvim} "$tmpfile" </dev/tty >/dev/tty
    local -a tmp_lines=("${(@f)$(<"$tmpfile")}")
    local line left_part right_part new_name clean_new target_dir
    local -a errors=()
    local -a valid_olds=() valid_news=()
    local -A old_set=() new_set=()
    # --- Phase 0.1: Parse and Basic Validation ---
    for line in "${tmp_lines[@]}"; do
        [[ -z "$line" || "$line" == \#* ]] && continue
        if [[ "$line" != *" -> "* ]]; then
            continue
        fi
        left_part="${line%% -> *}"
        right_part="${line#* -> }"
        old_name="${left_part}"
        new_name="${right_part}"
        [[ -z "$new_name" || "$new_name" == "$old_name" ]] && continue
        [[ ! -e "$old_name" ]] && continue
        if [[ -f "$old_name" ]]; then
            case "$new_name" in
                */)
                    errors+=("Cannot rename file '$old_name' to a path ending with '/'")
                    continue
                    ;;
            esac
        fi
        clean_new="${new_name%%/##}"
        [[ "$clean_new" == "$old_name" ]] && continue
        # Prevent multiple files targeting the exact same new name internally
        if [[ -n "${new_set[$clean_new]}" ]]; then
            errors+=("Multiple files target '$clean_new'. Skipped '$old_name'")
            continue
        fi
        valid_olds+=("$old_name")
        valid_news+=("$clean_new")
        old_set[$old_name]=1
        new_set[$clean_new]=1
    done

    # --- Phase 0.2: Iterative Pruning (Cascade Rollback) ---
    # Continuously evaluate conflicts until the dependency chain is perfectly stable
    local changed=1
    local i o n
    while (( changed )); do
        changed=0
        local -a next_olds=() next_news=()
        for (( i=1; i<=${#valid_olds[@]}; i++ )); do
            o="${valid_olds[$i]}"
            n="${valid_news[$i]}"
            # If target exists physically AND is NOT part of the currently moving items
            if [[ -e "$n" && -z "${old_set[$n]}" ]]; then
                errors+=("'$n' blocks path. Cascade cancelled rename for '$o'")
                # CRITICAL: Remove this dropped item from the safe set so dependents will fail in the next loop
                unset "old_set[$o]"
                changed=1
            else
                next_olds+=("$o")
                next_news+=("$n")
            fi
        done
        valid_olds=("${next_olds[@]}")
        valid_news=("${next_news[@]}")
    done

    # --- Phase 1 & 2: Safe Execution (Two-pass algorithm) ---
    local -a final_olds=("${valid_olds[@]}")
    local -a final_news=("${valid_news[@]}")
    local -a final_tmps=()
    for (( i=1; i<=${#final_olds[@]}; i++ )); do
        final_tmps+=("${final_olds[$i]}.__ipre_tmp_${RANDOM}_$$")
    done
    for (( i=1; i<=${#final_olds[@]}; i++ )); do
        mv -- "${final_olds[$i]}" "${final_tmps[$i]}"
    done
    for (( i=1; i<=${#final_tmps[@]}; i++ )); do
        target_dir="${final_news[$i]:h}"
        if [[ "$target_dir" != "." && ! -d "$target_dir" ]]; then
            mkdir -p "$target_dir"
        fi
        mv -- "${final_tmps[$i]}" "${final_news[$i]}"
        if [[ ! -f "$IPRE_RAM_FOCUS_FILE" ]]; then
            echo "${final_news[$i]:t}" > "$IPRE_RAM_FOCUS_FILE"
        fi
    done
    rm -f -- "$tmpfile"
    if [[ ${#errors[@]} -gt 0 ]]; then
        {
            enter_alt_screen
            print_warn "Wdired Completed with Errors (Rollback Applied)"
            local err
            for err in "${errors[@]}"; do
                printf "  %b- %s%b\n" "$C_YLW" "$err" "$C_RST"
            done
            echo ""
            printf "Press any key to return..."
        } > /dev/tty

        read -k 1 -s _ < /dev/tty
        leave_alt_screen
    fi
}


